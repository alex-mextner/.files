#!/usr/bin/env bash
# claude-rotate — run `claude` through one of several personal Claude.ai
# subscription accounts, auto-rotating to the next account when the active
# one hits its session/weekly usage limit.
#
# WHY THIS EXISTS
#   Claude Code has no built-in multi-account switch (`claude auth login`,
#   `claude auth logout`, `claude auth status` are the only auth subcommands).
#   The supported way to keep N separate logins side by side is to point
#   CLAUDE_CONFIG_DIR at a dedicated directory per account — each directory
#   holds that account's own credentials/settings, completely independent of
#   `~/.claude` (the directory the plain `claude` binary uses by default).
#   Switching accounts is a PROCESS-LAUNCH decision, not a mid-session
#   hot-swap: a running session lives in one config dir for its whole life.
#
# LAYOUT
#   ~/.claude-accounts/account-1/   CLAUDE_CONFIG_DIR for account 1
#   ~/.claude-accounts/account-2/   CLAUDE_CONFIG_DIR for account 2
#   ~/.claude-accounts/account-3/   CLAUDE_CONFIG_DIR for account 3
#   ~/.claude-accounts/current      state file: which account dir to try first
#   ~/.claude-accounts/rotate.log   append-only log of rotation/switch events
#   Add a 4th (or Nth) account by running: claude-rotate rotate login account-4
#   — any `account-*` directory under ~/.claude-accounts is auto-discovered,
#   no script edit needed.
#
# USAGE
#   claude-rotate [claude args/prompt...]   run claude via the current account;
#                                            auto-rotate on a detected limit hit
#   claude-rotate --tmux <name> [claude args...]
#                                            same, but INSIDE a new tmux window
#                                            named <name> (created in the current
#                                            tmux session, or in a fresh/attached
#                                            server when not in tmux) and with
#                                            `--name <name>` passed to claude, so
#                                            tg-ctl can both see and reach it.
#                                            See TMUX GUARD below.
#   claude-rotate rotate                    show account status, same as
#                                            'rotate accounts' — at a real
#                                            interactive terminal with no
#                                            other args, this is an arrow-key
#                                            picker (↑/↓ + Enter to switch,
#                                            q/Esc to cancel); piped/scripted/
#                                            agent-driven calls always get the
#                                            plain static table instead
#   claude-rotate accounts                  same as 'rotate' / 'rotate
#                                            accounts' — "accounts" is a
#                                            second top-level entry point,
#                                            equally safe (no real `claude`
#                                            command is named that either),
#                                            and every 'rotate' subcommand
#                                            works under it too, e.g.
#                                            'claude accounts use 2'
#   claude-rotate rotate accounts list [--no-verify]
#   claude-rotate rotate list [--no-verify]
#                                            ALWAYS the plain static table
#                                            (never the interactive picker,
#                                            even at a terminal) — logged-in
#                                            state, email, plan per account.
#                                            Makes one real, cheap Haiku call
#                                            per account by DEFAULT to confirm
#                                            each one genuinely works, not just
#                                            trusting the cached 'claude auth
#                                            status' flag; --no-verify (or
#                                            --fast) skips that for a quicker,
#                                            free check
#   claude-rotate rotate use <name|N|login> [--relaunch-panes]
#                                            force the current account (no
#                                            launch) — accepts the full dir
#                                            name ("account-2"), a bare
#                                            number ("2"), or the account's
#                                            login/email ("alex" or
#                                            "alex@gmail.com"). Only affects
#                                            the NEXT claude launch — see LIVE
#                                            ACCOUNT SWITCHING below.
#                                            --relaunch-panes skips the y/N
#                                            prompt and relaunches every
#                                            detected stale tmux pane right
#                                            away (still prints the same
#                                            data-loss warning first)
#   claude-rotate rotate next [--relaunch-panes]
#                                            force-advance to the next account
#   claude-rotate rotate login [name...]    log into every registered account
#   claude-rotate rotate relogin [name...]  that isn't currently logged in
#                                            (or just the given ones); also
#                                            registers brand-new account-N
#                                            dirs that don't exist yet.
#                                            'relogin' is just an alias for
#                                            'login', same command
#   claude-rotate rotate --help             this help
#
#   Every argument whose FIRST word isn't the literal "rotate"/"accounts"
#   (including a bare `-h`/`--help`, `-p "prompt"`, or no args at all) is
#   forwarded to the real `claude` binary untouched — "rotate" and "accounts"
#   are a private subcommand namespace chosen specifically because no real
#   `claude` command is named either of those (checked `claude --help`'s
#   Commands list), so they can never collide with a current or future
#   `claude` CLI command.
#
# LIVE ACCOUNT SWITCHING (what 'rotate use'/'rotate next' can and can't do)
#   Claude Code reads CLAUDE_CONFIG_DIR once at process launch and never
#   re-reads it — an already-running interactive session (this pane or any
#   other) keeps using whatever account it started with for its entire life,
#   no matter how many times you run 'rotate use' elsewhere. There is no
#   live/in-session account-switch API in the CLI (checked `claude auth
#   --help` and the full `claude --help` Commands list — nothing fits).
#   So 'rotate use'/'rotate next'/the interactive picker do two things:
#     1. update the state file, so the NEXT `claude`/`claude-rotate` launch
#        (this pane, once you exit and restart, or a brand-new pane) picks
#        up the new account — this always works, no caveats.
#     2. detect every OTHER tmux pane currently running an interactive
#        claude session (Claude Code self-reports its process title as its
#        own bare version string, e.g. "2.1.251" — that's how detection
#        works, no fragile process-tree walking) and OFFER to relaunch them:
#        at an interactive terminal you get a y/N prompt; non-interactively
#        you get the list + instructions only, unless --relaunch-panes was
#        passed explicitly. A relaunched pane gets Escape first (safely
#        interrupts an active turn, waits for it to actually go idle —
#        aborts rather than forcing if it doesn't), THEN Ctrl-C twice
#        (verified to actually exit claude to a real shell, not assumed —
#        aborts if it doesn't), THEN a clean in-place restart onto the new
#        account's CLAUDE_CONFIG_DIR — but starts a BRAND NEW conversation: each
#        account has its own separate session/history store, so nothing
#        from the old conversation carries over (checked: `claude -c/--continue`
#        and `-r/--resume` only reach conversations THAT config dir has
#        already seen, they can't cross accounts). For the pane you're
#        actually typing in, just run `exec claude` yourself when ready.
#
# 5h/7d USAGE-LIMIT NUMBERS
#   Not shown by 'rotate accounts' — investigated and confirmed there is no
#   headless CLI surface for them: `claude auth status --json` only returns
#   loggedIn/email/subscriptionType/org fields, `claude doctor` reports
#   install health (not usage), and `claude --help` has no usage/quota
#   subcommand (only /usage exists, and it's a TUI-only slash command with no
#   -p/non-interactive equivalent). Check them inside an interactive session
#   with /usage instead.
#
# TMUX GUARD (agent-tools#526 / tg-cli#306)
#   tg-ctl (the Telegram bridge) discovers agents via `tmux list-panes` and
#   delivers replies via `tmux send-keys`. An INTERACTIVE session started from a
#   plain terminal tab (no $TMUX) is therefore only half-reachable from the
#   phone: it shows up in `tg-ctl status` as "unreachable: not in tmux", and a
#   message to it is queued to its Stop-hook inbox — delivered at the agent's
#   NEXT turn end, never typed into its prompt. Incident 2026-09-05: two agents
#   launched this way were simply invisible for hours. So this launcher:
#     - WARNS loudly on stderr when $TMUX is unset and the run is interactive
#       (a TTY, no -p/--print) — CLAUDE_ROTATE_REQUIRE_TMUX=warn (default);
#     - with CLAUDE_ROTATE_REQUIRE_TMUX=wrap, auto-wraps such a run into a tmux
#       window (named after --name, else the cwd basename) as if --tmux were given;
#     - with CLAUDE_ROTATE_REQUIRE_TMUX=off stays silent.
#   `--tmux <name>` is the explicit form: it re-execs THIS launcher (minus the
#   flag, plus `--name <name>`) inside a new tmux window named <name>, in the
#   current session when already in tmux, otherwise in the default server
#   (created + attached when none is running). rig's `harness.require_tmux`
#   option is the intended way to set the env var machine-wide (follow-up).
#
# HOW ROTATION IS TRIGGERED
#   The CURRENT account (persisted in the state file) is always tried FIRST —
#   this never force-rotates on a normal, successful call. A rotation only
#   happens when that attempt looks exhausted:
#     - non-interactive/piped calls (stdout not a TTY, e.g. `-p` / scripted
#       use): output is captured and scanned for limit/quota text
#       ("session limit", "weekly limit", "usage limit", "rate limit", "limit
#       reached", "quota exceeded", ...), OR
#     - ANY call: the process exits non-zero within CLAUDE_ROTATE_FAST_EXIT_SECS
#       (default 10s) of launch — a fast failure looks like an auth/limit
#       problem, not real work ending in error.
#   A Ctrl-C/SIGTERM exit (130/143) is never treated as exhaustion — that's
#   the user quitting, not a limit.
#   KNOWN LIMITATION: a limit hit deep into a long INTERACTIVE session (one
#   that doesn't crash the process) can't be detected this way — capturing an
#   interactive TUI's output to scan it would break the TUI itself, so the
#   interactive path only ever gets the "fast exit" signal, never text
#   matching. If Claude just refuses further turns without exiting, restart
#   the session (or run `claude-rotate rotate next` yourself) to force a
#   switch.
#   Non-interactive/piped output is merged (stdout+stderr) while captured for
#   scanning — a documented trade-off to keep the capture simple; a caller
#   relying on separate streams should not pipe through this wrapper.
#
# WIRING IT IN (so plain `claude` goes through rotation transparently)
#   A zsh alias `claude -> claude-rotate` is set in ~/.files/aliases.zsh (a
#   SEPARATE tracked change in that file, not part of this script) — see the
#   comment there for why an alias (not PATH-shadowing the real binary) was
#   chosen. ENABLED as of 2026-08-30 on this machine, once all registered
#   accounts were confirmed logged in via `rotate accounts` — enabling it earlier, before
#   any account was set up, broke plain `claude` outright (see .files#2).
#
# SETUP (do this once per new account slot — interactive, cannot be
# automated: it's a real browser OAuth login)
#   claude-rotate rotate login
#
# State updates are NOT locked — concurrent claude-rotate invocations can
# race on the state file. Acceptable for a single personal user; not meant
# for heavy concurrent/background use.

set -uo pipefail
# NOTE: deliberately no `set -e` (errexit) — this script's whole job is to
# inspect and react to a child `claude` process's non-zero exit codes, which
# errexit would abort the script on before we get to look at them.

ACCOUNTS_ROOT="${CLAUDE_ROTATE_ROOT:-$HOME/.claude-accounts}"
STATE_FILE="$ACCOUNTS_ROOT/current"
LOG_FILE="$ACCOUNTS_ROOT/rotate.log"
FAST_EXIT_THRESHOLD="${CLAUDE_ROTATE_FAST_EXIT_SECS:-10}"
LIMIT_PATTERN='session limit|weekly limit|usage limit|rate.?limit|limit reached|quota exceeded|try again later|resets (at|in)'
VERIFY_MODEL="${CLAUDE_ROTATE_VERIFY_MODEL:-haiku}"
# Display name for all user-facing messages/help text. $0 can't carry the
# invoked alias name through a shell alias (aliases are textual substitution
# before exec, argv[0] is set to the real script path regardless) — so
# ~/.files/aliases.zsh's `claude` alias sets CLAUDE_ROTATE_PROG=claude
# explicitly before exec'ing this script, and we fall back to basename "$0"
# (the real script name) when invoked directly as claude-rotate or with no
# override.
PROG="${CLAUDE_ROTATE_PROG:-$(basename "$0")}"

# ---------------------------------------------------------------------------
# account registry helpers
# ---------------------------------------------------------------------------

# Prints registered account names (basenames of ~/.claude-accounts/account-*),
# one per line, sorted. The single source of truth for "what accounts exist" —
# adding a directory here is all it takes to register a new account.
list_accounts() {
  local d
  for d in "$ACCOUNTS_ROOT"/account-*/; do
    [[ -d "$d" ]] || continue
    basename "$d"
  done | sort -V
}

log_event() {
  mkdir -p "$ACCOUNTS_ROOT"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"
}

# Reads the persisted "current" account, falling back to the first registered
# account if the state file is missing/stale (points at a since-removed dir).
# Does not persist the fallback itself — callers persist whatever they end up
# actually using.
get_current_account() {
  local -a accounts=("$@")
  local saved="" a
  [[ -f "$STATE_FILE" ]] && saved="$(<"$STATE_FILE")"
  saved="${saved//[$'\t\r\n ']/}"
  for a in "${accounts[@]}"; do
    [[ "$a" == "$saved" ]] && { echo "$saved"; return; }
  done
  echo "${accounts[0]}"
}

set_current_account() {
  mkdir -p "$ACCOUNTS_ROOT"
  echo "$1" >"$STATE_FILE"
}

# Quick, cheap (no token spend) check of whether an account dir is logged in.
is_account_logged_in() {
  local dir="$1"
  CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null | grep -q '"loggedIn": *true'
}

# Real, non-cached check: makes one minimal Haiku call through the account's
# config dir and confirms a genuine successful response — 'claude auth
# status' only reports a locally cached login flag, which can be stale (e.g.
# a revoked session still reads loggedIn:true until the next real call).
# Costs a small amount of real API usage; only call this on explicit --verify.
verify_account_live() {
  local dir="$1"
  local out
  out="$(CLAUDE_CONFIG_DIR="$dir" claude -p 'reply with just: pong' --model "$VERIFY_MODEL" --output-format json 2>/dev/null)"
  [[ -z "$out" ]] && return 1
  printf '%s' "$out" | grep -q '"is_error": *false' || return 1
  printf '%s' "$out" | grep -qE '"result": *"[^"]+"'
}

# Rotates $accounts so it starts at $current and wraps around — the order in
# which run_with_rotation() tries accounts this invocation.
rotation_order() {
  local current="$1"; shift
  local -a accounts=("$@")
  local i start=0
  for i in "${!accounts[@]}"; do
    [[ "${accounts[$i]}" == "$current" ]] && { start=$i; break; }
  done
  local n=${#accounts[@]} j
  for ((j = 0; j < n; j++)); do
    echo "${accounts[$(((start + j) % n))]}"
  done
}

# ---------------------------------------------------------------------------
# live tmux pane detection/relaunch (see header comment: LIVE ACCOUNT SWITCHING)
# ---------------------------------------------------------------------------

# Lists every OTHER tmux pane, across every session, currently running an
# interactive claude session — one TAB-delimited "pane_id  target  path
# version" line per match, excluding this process's own pane ($TMUX_PANE
# — read find_claude_panes' own body for the exact field order, this
# comment previously said pipe-delimited after the delimiter was already
# switched to tab, review finding). Detection works off
# Claude Code self-reporting its process title as its own bare version string
# (verified live, 2026-08-30: `claude --version` prints "X.Y.Z (Claude Code)",
# and a pane running it shows pane_current_command "X.Y.Z") — reliable, and
# doesn't need any process-tree walking (which is unreliable to script from
# inside a sandboxed tool-call subprocess anyway; tg-cli's discover.ts has to
# walk the process tree for OTHER harnesses precisely because THEY don't get
# this convenient direct signal — claude-rotate doesn't need that complexity).
find_claude_panes() {
  command -v tmux >/dev/null 2>&1 || return 0
  # Tab-delimited (not '|'): a pane_current_path containing a literal '|'
  # would otherwise mis-shift every field after it (review finding).
  tmux list-panes -a -F $'#{pane_id}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_current_path}\t#{pane_current_command}' 2>/dev/null |
    awk -F'\t' -v self="${TMUX_PANE:-}" '$4 ~ /^[0-9]+\.[0-9]+\.[0-9]+$/ && $1 != self'
}

# True (0) iff pane_current_command no longer matches claude's own
# version-string self-report — i.e. the process has actually exited to a
# shell, not merely gone idle inside claude (idle-inside-claude and
# exited-to-shell are DIFFERENT states — see pane_quit_to_shell's header
# comment for why this distinction is safety-critical).
pane_has_exited_claude() {
  local cur
  cur="$(tmux list-panes -t "$1" -F '#{pane_current_command}' 2>/dev/null)"
  [[ -n "$cur" && ! "$cur" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

# Read-only: dumps a pane's currently visible text. Never mutates anything.
pane_capture() {
  tmux capture-pane -p -t "$1" 2>/dev/null
}

# True (0) iff the pane's last visible content is a bare, empty input prompt
# with no in-flight work indicator — Claude Code's idle state. Observed live
# (2026-08-30, real panes on this machine): idle panes end in a lone "❯ "
# line directly above the "auto mode on" status footer, with no elapsed-time
# counter ("Churned for …"), no active permission/plan menu, and no
# background-subagent status rows (those carry an elapsed-time+token column,
# e.g. "◯ general-purpose  <task>  12m 3s · ↓ 40.1k tokens" — a MAIN thread
# can look idle while a background subagent is still working; that's fine to
# relaunch through since the subagent is a separate process tree that isn't
# affected by restarting the parent pane's foreground claude, but we still
# treat its presence as "not cleanly idle" and let the polling loop keep
# waiting rather than guess). Deliberately whitelist-based (idle proven, not
# busy proven) — anything not clearly matching this shape is treated as NOT
# idle, so the safe default on ambiguous/unrecognized output is "keep
# waiting / eventually abort", never "assume it's fine to relaunch".
pane_looks_idle() {
  local text
  text="$(pane_capture "$1")"
  [[ -z "$text" ]] && return 1
  grep -qE '(Churned for|Do you want to proceed\?|Would you like to proceed\?|esc to interrupt)' <<<"$text" && return 1
  grep -qE '[0-9]+[hms] .*↓ [0-9.]+k? ?tokens' <<<"$text" && return 1
  # A bare, empty prompt cursor line must appear near the end (real captures
  # put the status footer AFTER the prompt line, so it's not literally the
  # LAST line — verified against real panes on this machine, 2026-08-30).
  tail -6 <<<"$text" | grep -qE '^❯[[:space:]]*$'
}

# Sends the pane's own safe in-app interrupt (Escape — Claude Code's
# documented "esc to interrupt" key; NOT Ctrl-C, which risks killing the
# process outright instead of just stopping the current turn) and polls
# (capture-pane, no other side effect) until pane_looks_idle or a bounded
# timeout. Returns 0 once idle, 1 on timeout — callers MUST treat 1 as "do
# not relaunch this pane, abort and report it needs manual handling" per this
# tool's own safety contract; never force through a timeout.
pane_interrupt_and_wait() {
  local target="$1" timeout="${2:-8}" waited=0
  tmux send-keys -t "$target" Escape 2>/dev/null
  # waited counts 0.5s ticks, so the real budget is timeout*2 ticks — a plain
  # `waited < timeout` here previously halved the documented budget (review
  # finding: an 8s caller only got ~4s of real wall-clock wait).
  while (( waited < timeout * 2 )); do
    pane_looks_idle "$target" && return 0
    sleep 0.5
    waited=$((waited + 1))
  done
  pane_looks_idle "$target"
}

# CRITICAL correctness fix (caught by review before this ever shipped):
# pane_interrupt_and_wait reaching "idle" means claude stopped its current
# TURN — claude is still the foreground app, sitting at ITS OWN input box.
# Typing a shell command at that point does NOT run in a shell — it gets
# submitted as a CHAT MESSAGE to claude on the pane's CURRENT (old) account,
# silently burning real usage on the very account being switched away from,
# while never actually relaunching anything. Verified empirically (real
# claude process, throwaway synthetic tmux session, 2026-08-30): once idle,
# Ctrl-C shows "Press Ctrl-C again to exit"; a second Ctrl-C genuinely quits
# the process, and pane_current_command transitions away from the
# version-string the instant it does (confirmed: went from a version string
# to "bash"). Requires being idle FIRST — Ctrl-C on a BUSY pane only
# interrupts the current turn (same as Escape), it doesn't arm the exit
# prompt, so calling this before pane_interrupt_and_wait succeeded would not
# reliably quit. Returns 0 once the pane has genuinely exited to a shell, 1
# on timeout — same "abort, never force" contract as pane_interrupt_and_wait.
pane_quit_to_shell() {
  local target="$1" timeout="${2:-5}" waited=0
  tmux send-keys -t "$target" C-c 2>/dev/null
  sleep 0.4
  tmux send-keys -t "$target" C-c 2>/dev/null
  while (( waited < timeout * 2 )); do
    pane_has_exited_claude "$target" && return 0
    sleep 0.5
    waited=$((waited + 1))
  done
  pane_has_exited_claude "$target"
}

# Relaunches one pane — ALREADY CONFIRMED via pane_quit_to_shell to have
# actually exited to a real shell — under a NEW account's CLAUDE_CONFIG_DIR.
# Follows tg-cli's proven tmux-injection pacing (features/tg-ctl/inject.ts,
# buildTextInjectPlan): literal single-line send-keys (-l, no key-name
# interpretation) for the command text, THEN a separate paced Enter — a
# combined "text + Enter" in one send-keys call is documented there as
# unreliable (dropped by the Ink TUI on a fast/combined submit). Callers
# MUST have verified pane_quit_to_shell succeeded first — this function does
# not itself check, since re-checking on every call would race against its
# own caller's already-fresh check for no benefit.
pane_relaunch() {
  local target="$1" config_dir="$2"
  local cmd
  # `command claude` (not bare `claude`) — the `claude` alias is enabled on
  # this machine (aliases.zsh) and a target pane is an interactive zsh where
  # the word after `exec` DOES alias-expand. Without `command`, this would
  # actually re-invoke claude-rotate ITSELF (the alias's expansion), which
  # ignores the CLAUDE_CONFIG_DIR we just set and instead reads the state
  # file — landing on whatever account is current AT THAT LATER MOMENT, not
  # necessarily the one this call intends (a real race across a multi-pane
  # relaunch loop: another `rotate use` in between changes the state file).
  # `command` forces the real binary, honoring our explicit env var exactly
  # (review finding, cross-confirmed by two independent reviewers).
  printf -v cmd 'CLAUDE_CONFIG_DIR=%q exec command claude' "$config_dir"
  tmux send-keys -t "$target" -l "$cmd" 2>/dev/null
  sleep 0.5
  tmux send-keys -t "$target" Enter 2>/dev/null
}

# After a manual account switch (rotate use/next/the interactive picker),
# detect+offer to relaunch every OTHER tmux pane still running claude under
# the OLD account, onto $2 (the newly chosen account name — used to resolve
# the CLAUDE_CONFIG_DIR each relaunched pane actually needs; the earlier
# version of this function never threaded this through at all, so it never
# actually switched anything). $1: 1 to skip the y/N prompt and just do it
# (still prints the same warnings) — pass 1 only for an explicit
# --relaunch-panes call, never as a silent default; a non-interactive caller
# with $1=0 gets the list + instructions only, no pane is touched.
offer_relaunch_stale_panes() {
  local force="${1:-0}" new_account="${2:-}"
  local -a panes
  mapfile -t panes < <(find_claude_panes)
  [[ ${#panes[@]} -eq 0 ]] && return 0

  local p pane_id target path ver
  echo
  echo "$PROG: ${#panes[@]} other tmux pane(s) are running an interactive claude session."
  echo "(claude-rotate can't see which account a pane is actually on — this is a BEST-EFFORT list of"
  echo "every live claude pane, not confirmed to be on the old account specifically. Check the paths"
  echo "below before confirming; a pane on some OTHER account entirely would get swept up too.)"
  for p in "${panes[@]}"; do
    IFS=$'\t' read -r pane_id target path ver <<<"$p"
    echo "  - $target   $path   (claude $ver)"
  done
  echo "This pane: run 'exec claude' yourself when ready to relaunch it under the new account."
  echo "Relaunching a pane: Escape first (safely interrupts an active turn, waiting for it to go"
  echo "idle — aborts that pane rather than forcing if it doesn't), then Ctrl-C twice to actually"
  echo "quit claude back to a shell (verified, not assumed — aborts if it doesn't really exit),"
  echo "THEN starts a BRAND NEW conversation there. Each account has its own separate session"
  echo "history, nothing from the old conversation carries over."

  if [[ -z "$new_account" ]]; then
    echo "$PROG: internal error — no target account given, not touching any pane." >&2
    return 1
  fi
  if ! is_account_logged_in "$ACCOUNTS_ROOT/$new_account"; then
    echo "$PROG: $new_account is not logged in — run '$PROG rotate relogin $new_account' first. No pane was touched."
    return 1
  fi

  if [[ $force -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      echo "Run with --relaunch-panes to relaunch them automatically (no prompt) — skipping for now, no pane was touched."
      return 0
    fi
    local reply=""
    read -r -p "Relaunch all ${#panes[@]} of them now? [y/N] " reply
    [[ "$reply" =~ ^[Yy] ]] || { echo "Skipped — no pane was touched."; return 0; }
  fi

  local config_dir="$ACCOUNTS_ROOT/$new_account"
  for p in "${panes[@]}"; do
    IFS=$'\t' read -r pane_id target path ver <<<"$p"
    if ! pane_interrupt_and_wait "$pane_id" 8; then
      echo "  SKIPPED $target — did not settle to idle within 8s after interrupt; needs manual handling (it may be mid a long tool call). Not touched further."
      log_event "pane skip (not idle) -> $target"
      continue
    fi
    if ! pane_quit_to_shell "$pane_id" 5; then
      echo "  SKIPPED $target — went idle but did not actually exit to a shell within 5s; needs manual handling. Not touched further."
      log_event "pane skip (did not exit) -> $target"
      continue
    fi
    pane_relaunch "$pane_id" "$config_dir"
    echo "  relaunched $target onto $new_account"
    log_event "pane relaunch -> $target onto $new_account"
  done
}

# ---------------------------------------------------------------------------
# running claude and judging the result
# ---------------------------------------------------------------------------

# Runs `claude "$@"` against $1's config dir, sets the globals LAST_EXIT_CODE,
# LAST_ELAPSED (seconds), LAST_OUTPUT_MATCHED (1 if limit text was seen —
# only possible on the non-TTY path, see header comment).
run_claude_once() {
  local dir="$1"; shift
  local start end rc
  start=$(date +%s)
  if [[ -t 1 ]]; then
    # Interactive: full TTY passthrough, no capture (capturing would break
    # the TUI). Only the exit code + timing are usable signals here.
    CLAUDE_CONFIG_DIR="$dir" claude "$@"
    rc=$?
    LAST_OUTPUT_MATCHED=0
  else
    # Non-interactive/piped: capture (stdout+stderr merged, see header
    # comment) so it can both be scanned for limit text AND still reach the
    # real caller. The pipeline blocks until `tee` has fully drained, so
    # there's no race reading the temp file right after.
    local combined
    combined="$(mktemp)"
    CLAUDE_CONFIG_DIR="$dir" claude "$@" 2>&1 | tee "$combined"
    rc=${PIPESTATUS[0]}
    if grep -Eiq "$LIMIT_PATTERN" "$combined" 2>/dev/null; then
      LAST_OUTPUT_MATCHED=1
    else
      LAST_OUTPUT_MATCHED=0
    fi
    rm -f "$combined"
  fi
  end=$(date +%s)
  LAST_EXIT_CODE=$rc
  LAST_ELAPSED=$((end - start))
}

# True if this attempt's result looks like exhaustion (limit text seen, or a
# non-zero exit that came back fast) rather than a real, unrelated error.
looks_exhausted() {
  [[ "${LAST_OUTPUT_MATCHED:-0}" -eq 1 ]] && return 0
  [[ "$LAST_EXIT_CODE" -ne 0 && "$LAST_ELAPSED" -lt "$FAST_EXIT_THRESHOLD" ]] && return 0
  return 1
}

# ---------------------------------------------------------------------------
# tmux guard (see header: TMUX GUARD)
# ---------------------------------------------------------------------------

# True when the invocation is an INTERACTIVE session: a TTY on stdout and no
# headless flag among the args (-p/--print, or a bare version/help query).
is_interactive_run() {
  [[ -t 1 ]] || return 1
  local a
  for a in "$@"; do
    case "$a" in
      -p | --print | -v | --version | -h | --help) return 1 ;;
    esac
  done
  return 0
}

# The `--name <v>` / `--name=<v>` value among the claude args, if any.
name_from_args() {
  local prev="" a
  for a in "$@"; do
    if [[ "$prev" == "--name" ]]; then printf '%s' "$a"; return 0; fi
    case "$a" in --name=*) printf '%s' "${a#--name=}"; return 0 ;; esac
    prev="$a"
  done
  return 1
}

# Run THIS launcher inside a new tmux window named $1 with the remaining args
# (plus `--name $1` unless the args already carry one). Inside tmux: a window in
# the current session. Outside: a window in the default server (a fresh `main`
# session when no server runs), then attach so the user lands in it.
run_in_tmux_window() {
  local name="$1"; shift
  if ! command -v tmux >/dev/null 2>&1; then
    echo "$PROG: --tmux needs tmux on PATH" >&2
    return 1
  fi
  local -a args=("$@")
  name_from_args "$@" >/dev/null || args=(--name "$name" "${args[@]}")
  # Re-exec ourselves (not the raw binary) so rotation still applies in the window.
  local cmd
  cmd="exec $(printf '%q ' "$0" "${args[@]}")"
  if [[ -n "${TMUX:-}" ]]; then
    tmux new-window -n "$name" -c "$PWD" "$cmd" || return 1
    return 0
  fi
  if tmux has-session 2>/dev/null; then
    tmux new-window -n "$name" -c "$PWD" "$cmd" || return 1
  else
    tmux new-session -d -s main -n "$name" -c "$PWD" "$cmd" || return 1
  fi
  exec tmux attach
}

# The warn/wrap decision for a plain (no --tmux) interactive run outside tmux.
# Returns 0 when the caller should CONTINUE running claude here; in wrap mode it
# hands the run to a tmux window and exits.
tmux_guard() {
  local mode="${CLAUDE_ROTATE_REQUIRE_TMUX:-warn}"
  [[ "$mode" == "off" ]] && return 0
  [[ -n "${TMUX:-}" ]] && return 0
  is_interactive_run "$@" || return 0
  local name
  name="$(name_from_args "$@" || basename "$PWD")"
  if [[ "$mode" == "wrap" ]]; then
    echo "$PROG: not in tmux — wrapping into a tmux window '$name' (CLAUDE_ROTATE_REQUIRE_TMUX=wrap)" >&2
    run_in_tmux_window "$name" "$@"
    exit $?
  fi
  cat >&2 <<WARN
$PROG: WARNING — not running inside tmux (\$TMUX is unset).
  tg-ctl cannot reach this agent from Telegram: it will show as "unreachable: not in
  tmux" and a message to it is only queued to its Stop-hook inbox (delivered at the
  agent's next turn end, never typed into its prompt).
  Fix: start it inside tmux — \`$PROG --tmux $name\` — or run it in a tmux window.
  Silence: CLAUDE_ROTATE_REQUIRE_TMUX=off; auto-wrap: CLAUDE_ROTATE_REQUIRE_TMUX=wrap.
WARN
  return 0
}

# ---------------------------------------------------------------------------
# main: try the current account, rotate forward on exhaustion
# ---------------------------------------------------------------------------

main_run() {
  tmux_guard "$@"
  mkdir -p "$ACCOUNTS_ROOT"
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  if [[ ${#accounts[@]} -eq 0 ]]; then
    echo "$PROG: no accounts registered under $ACCOUNTS_ROOT." >&2
    echo "Run '$PROG rotate login' first." >&2
    exit 1
  fi

  local current
  current="$(get_current_account "${accounts[@]}")"
  local -a order
  mapfile -t order < <(rotation_order "$current" "${accounts[@]}")

  local i acct next_acct
  for i in "${!order[@]}"; do
    acct="${order[$i]}"

    # Only pre-check login state for accounts we're rotating INTO after a
    # failure — the first (current) attempt skips this to keep the common
    # happy path at zero extra overhead. An unauthenticated current account
    # will simply fail on its own (interactively: claude shows its native
    # login screen; non-interactively: a fast auth error, which the
    # fast-exit heuristic below already rotates past).
    if [[ $i -gt 0 ]] && ! is_account_logged_in "$ACCOUNTS_ROOT/$acct"; then
      log_event "skip $acct: not logged in"
      continue
    fi

    [[ $i -gt 0 ]] && echo "$PROG: switching to $acct (previous account looked exhausted)" >&2

    run_claude_once "$ACCOUNTS_ROOT/$acct" "$@"

    if [[ "$LAST_EXIT_CODE" -eq 130 || "$LAST_EXIT_CODE" -eq 143 ]]; then
      # user hit Ctrl-C / process was killed — not exhaustion, don't rotate
      set_current_account "$acct"
      exit "$LAST_EXIT_CODE"
    fi

    if [[ "$LAST_EXIT_CODE" -eq 0 ]] || ! looks_exhausted; then
      # success, or a genuine unrelated error — either way this is where we
      # land; don't mask a real bug by cycling through every other account
      set_current_account "$acct"
      exit "$LAST_EXIT_CODE"
    fi

    log_event "rotate: $acct looked exhausted (exit=$LAST_EXIT_CODE elapsed=${LAST_ELAPSED}s text_match=${LAST_OUTPUT_MATCHED:-0})"
    next_acct="${order[$((i + 1))]:-}"
    [[ -n "$next_acct" ]] && set_current_account "$next_acct"
  done

  echo "$PROG: every registered, logged-in account looked exhausted." >&2
  echo "Try again later, or run '$PROG rotate accounts'." >&2
  exit 1
}

# ---------------------------------------------------------------------------
# 'rotate' subcommands
# ---------------------------------------------------------------------------

cmd_login() {
  mkdir -p "$ACCOUNTS_ROOT"
  local -a targets=("$@")
  if [[ ${#targets[@]} -eq 0 ]]; then
    mapfile -t targets < <(list_accounts)
    [[ ${#targets[@]} -eq 0 ]] && targets=(account-1 account-2 account-3)
  fi

  local a dir any_attempted=0
  for a in "${targets[@]}"; do
    if [[ "$a" != account-* ]]; then
      echo "$PROG: '$a' doesn't match the required 'account-<name>' naming (e.g. account-4) — skipping, since list_accounts() only auto-discovers 'account-*' directories." >&2
      continue
    fi
    dir="$ACCOUNTS_ROOT/$a"
    mkdir -p "$dir"
    if is_account_logged_in "$dir"; then
      continue
    fi
    any_attempted=1
    echo
    echo "== $a: not logged in. Starting interactive login (opens a browser)... =="
    echo "   config dir: $dir"
    CLAUDE_CONFIG_DIR="$dir" claude auth login --claudeai
    if is_account_logged_in "$dir"; then
      echo "== $a: login verified =="
      log_event "login: $a logged in"
    else
      echo "== $a: still not logged in after that — rerun '$PROG rotate login $a' to retry ==" >&2
    fi
  done

  [[ $any_attempted -eq 0 ]] && echo "$PROG: every targeted account was already logged in — nothing to do."

  [[ -f "$STATE_FILE" ]] || {
    local -a all
    mapfile -t all < <(list_accounts)
    [[ ${#all[@]} -gt 0 ]] && set_current_account "${all[0]}"
  }
  return 0
}

# Renders the plain static accounts table — always non-interactive, used by
# an explicit 'list', by any non-TTY caller, and after Enter/cancel inside
# the interactive picker. $1: 1 to skip the live Haiku verify (--no-verify).
render_accounts_table() {
  local verify="$1"
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  if [[ ${#accounts[@]} -eq 0 ]]; then
    echo "No accounts registered yet. Run '$PROG rotate login'."
    return 0
  fi
  local current
  current="$(get_current_account "${accounts[@]}")"

  local a dir marker json logged_in email sub live_note
  for a in "${accounts[@]}"; do
    dir="$ACCOUNTS_ROOT/$a"
    marker=" "
    [[ "$a" == "$current" ]] && marker="*"
    json="$(CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null)"
    logged_in="$(printf '%s' "$json" | grep -o '"loggedIn": *[a-z]*' | grep -o '[a-z]*$')"
    if [[ "$logged_in" == "true" ]]; then
      email="$(printf '%s' "$json" | grep -o '"email": *"[^"]*"' | cut -d'"' -f4)"
      sub="$(printf '%s' "$json" | grep -o '"subscriptionType": *"[^"]*"' | cut -d'"' -f4)"
      live_note=""
      if [[ $verify -eq 1 ]]; then
        [[ -t 2 ]] && printf 'verifying %s (%s)...\r' "$a" "${email:-?}" >&2
        if verify_account_live "$dir"; then
          live_note="   live-verified OK ($VERIFY_MODEL)"
        else
          live_note="   live-verify FAILED (auth status says logged in, but a real $VERIFY_MODEL call failed)"
        fi
        [[ -t 2 ]] && printf '\033[K' >&2
      fi
      printf '%s %s   logged in   %s   (%s)%s\n' "$marker" "$a" "${email:-(no email)}" "${sub:-unknown plan}" "$live_note"
    else
      echo "$marker $a   NOT logged in — run: $PROG rotate login $a"
    fi
  done
  echo
  echo "* = current account (tried first on the next '$PROG' run)"
  echo "5h/7d usage-limit numbers aren't exposed by any headless 'claude' CLI command — check them inside a session with /usage."
  if [[ $verify -eq 0 ]]; then
    echo "tip: drop --no-verify to make one real, cheap $VERIFY_MODEL call per account instead of trusting the cached login flag (that's the default now)."
  fi
  return 0
}

# Pure-bash arrow-key account picker — only ever entered for a BARE
# 'rotate'/'rotate accounts'/'accounts' call (no args) at a real interactive
# terminal (see cmd_accounts). ↑/↓ to move, Enter to switch+exit, q/Esc to
# cancel without changing anything. Deliberately does NOT live-verify (that
# would add multiple seconds of latency before the menu even appears,
# defeating the whole point of "instant" manual switching) — use
# 'rotate list' for a verified static view.
interactive_picker() {
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  if [[ ${#accounts[@]} -eq 0 ]]; then
    echo "No accounts registered yet. Run '$PROG rotate login'."
    return 0
  fi
  local current
  current="$(get_current_account "${accounts[@]}")"

  local -a lines
  local a dir json logged_in email sub
  for a in "${accounts[@]}"; do
    dir="$ACCOUNTS_ROOT/$a"
    json="$(CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null)"
    logged_in="$(printf '%s' "$json" | grep -o '"loggedIn": *[a-z]*' | grep -o '[a-z]*$')"
    if [[ "$logged_in" == "true" ]]; then
      email="$(printf '%s' "$json" | grep -o '"email": *"[^"]*"' | cut -d'"' -f4)"
      sub="$(printf '%s' "$json" | grep -o '"subscriptionType": *"[^"]*"' | cut -d'"' -f4)"
      lines+=("$a   ${email:-(no email)}   (${sub:-unknown plan})")
    else
      lines+=("$a   NOT logged in")
    fi
  done

  local sel=0 i n=${#accounts[@]}
  for i in "${!accounts[@]}"; do
    [[ "${accounts[$i]}" == "$current" ]] && sel=$i
  done

  draw() {
    local j marker
    for j in "${!accounts[@]}"; do
      marker=" "
      [[ $j -eq $sel ]] && marker=">"
      printf '\033[K%s %s\n' "$marker" "${lines[$j]}"
    done
  }

  echo "Select an account — ↑/↓ + Enter to switch, q/Esc to cancel:"
  draw
  tput civis 2>/dev/null
  # A bare SIGINT (Ctrl-C) mid-`read` would otherwise kill the script between
  # civis and any of the cnorm calls below, leaving the cursor invisible for
  # the rest of the terminal session (review finding, confirmed by two
  # independent reviewers).
  trap 'tput cnorm 2>/dev/null' EXIT INT TERM

  local key key2 read_status
  while true; do
    IFS= read -rsn1 key
    read_status=$?
    # A failed/EOF read (Ctrl-D, or the pane's stdin closing) also yields an
    # empty $key — indistinguishable from Enter by content alone. Without
    # checking the exit status this silently took the "confirm selection"
    # branch on EOF (review finding) instead of cancelling.
    if [[ $read_status -ne 0 ]]; then
      printf '\033[%dA' "$n"
      draw
      echo "cancelled (input closed) — no change."
      tput cnorm 2>/dev/null
      return 0
    fi
    if [[ $key == $'\x1b' ]]; then
      IFS= read -rsn2 -t 0.05 key2
      case "$key2" in
        '[A') sel=$(((sel - 1 + n) % n)) ;;
        '[B') sel=$(((sel + 1) % n)) ;;
        '')
          printf '\033[%dA' "$n"
          draw
          echo "cancelled — no change."
          tput cnorm 2>/dev/null
          return 0
          ;;
      esac
      printf '\033[%dA' "$n"
      draw
      continue
    elif [[ -z "$key" ]]; then
      break # Enter
    elif [[ "$key" == "q" ]]; then
      printf '\033[%dA' "$n"
      draw
      echo "cancelled — no change."
      tput cnorm 2>/dev/null
      return 0
    fi
  done
  tput cnorm 2>/dev/null

  local chosen="${accounts[$sel]}"
  if [[ "$chosen" == "$current" ]]; then
    echo "Already on $chosen — nothing to do."
    return 0
  fi
  set_current_account "$chosen"
  log_event "manual switch (interactive) -> $chosen"
  echo "$PROG: current account set to $chosen"
  offer_relaunch_stale_panes 0 "$chosen"
  return 0
}

cmd_accounts() {
  local verify=1 explicit_list=0 arg
  for arg in "$@"; do
    case "$arg" in
      list) explicit_list=1 ;;
      --verify) : ;; # already the default; accepted so old muscle memory doesn't break
      --no-verify | --fast) verify=0 ;;
      *)
        echo "$PROG: unknown option '$arg' for 'rotate accounts' — usage: $PROG rotate accounts [list] [--no-verify]" >&2
        exit 1
        ;;
    esac
  done

  if [[ $explicit_list -eq 0 && $# -eq 0 && -t 0 && -t 1 ]]; then
    interactive_picker
    return $?
  fi

  render_accounts_table "$verify"
}

# Resolves a user-typed target to a registered account name, trying in order:
#   1. exact account dir name ("account-2")
#   2. bare number ("2" -> "account-2")
#   3. the account's authenticated login — full email or just the part before
#      "@" (so "alex" and "alex@gmail.com" both match an account logged in
#      as alex@gmail.com); requires a `claude auth status` call per account,
#      so only tried once the cheap matches above have failed.
# Echoes the resolved account name and returns 0, or returns 1 if nothing matched.
resolve_account() {
  local target="$1"; shift
  local -a accounts=("$@")
  local a

  for a in "${accounts[@]}"; do
    [[ "$a" == "$target" ]] && { echo "$a"; return 0; }
  done

  if [[ "$target" =~ ^[0-9]+$ ]]; then
    for a in "${accounts[@]}"; do
      [[ "$a" == "account-$target" ]] && { echo "$a"; return 0; }
    done
  fi

  local dir json email login_part target_lc
  target_lc="${target,,}"
  for a in "${accounts[@]}"; do
    dir="$ACCOUNTS_ROOT/$a"
    json="$(CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null)"
    email="$(printf '%s' "$json" | grep -o '"email": *"[^"]*"' | cut -d'"' -f4)"
    [[ -z "$email" ]] && continue
    login_part="${email%%@*}"
    if [[ "${email,,}" == "$target_lc" || "${login_part,,}" == "$target_lc" ]]; then
      echo "$a"
      return 0
    fi
  done

  return 1
}

cmd_use() {
  local target="" relaunch=0 arg
  for arg in "$@"; do
    case "$arg" in
      --relaunch-panes) relaunch=1 ;;
      *)
        if [[ -z "$target" ]]; then
          target="$arg"
        else
          echo "$PROG: unexpected extra argument '$arg' for 'rotate use'" >&2
          exit 1
        fi
        ;;
    esac
  done
  if [[ -z "$target" ]]; then
    echo "$PROG: 'rotate use' needs an account name, number, or login, e.g. '$PROG rotate use 2' or '$PROG rotate use alex'" >&2
    exit 1
  fi
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  local resolved
  if resolved="$(resolve_account "$target" "${accounts[@]}")" && [[ -n "$resolved" ]]; then
    local current
    current="$(get_current_account "${accounts[@]}")"
    if [[ "$resolved" == "$current" ]]; then
      echo "$PROG: already on $resolved — nothing to do."
      return 0
    fi
    set_current_account "$resolved"
    log_event "manual switch -> $resolved"
    echo "$PROG: current account set to $resolved"
    echo "(only affects the NEXT claude launch — an already-running session can't hot-swap, see '$PROG rotate --help')"
    offer_relaunch_stale_panes "$relaunch" "$resolved"
    return 0
  fi
  echo "$PROG: unknown account '$target'. Known: ${accounts[*]:-(none registered)}" >&2
  exit 1
}

cmd_next() {
  local relaunch=0 arg
  for arg in "$@"; do
    case "$arg" in
      --relaunch-panes) relaunch=1 ;;
      *)
        echo "$PROG: unexpected argument '$arg' for 'rotate next' — usage: $PROG rotate next [--relaunch-panes]" >&2
        exit 1
        ;;
    esac
  done
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  if [[ ${#accounts[@]} -eq 0 ]]; then
    echo "$PROG: no accounts registered." >&2
    exit 1
  fi
  local current i next_idx=0
  current="$(get_current_account "${accounts[@]}")"
  for i in "${!accounts[@]}"; do
    [[ "${accounts[$i]}" == "$current" ]] && { next_idx=$(((i + 1) % ${#accounts[@]})); break; }
  done
  if [[ "${accounts[$next_idx]}" == "$current" ]]; then
    echo "$PROG: only one account registered ($current) — nothing to rotate to."
    return 0
  fi
  set_current_account "${accounts[$next_idx]}"
  log_event "manual force-next -> ${accounts[$next_idx]}"
  echo "$PROG: current account set to ${accounts[$next_idx]}"
  offer_relaunch_stale_panes "$relaunch" "${accounts[$next_idx]}"
}

cmd_rotate_help() {
  # Quick reference — the header comment at the top of this file has the
  # full explanation (detection rules, wiring, live-switch limitations).
  cat <<EOF
$PROG — run claude through one of several personal accounts,
auto-rotating on a detected session/weekly limit hit.

  $PROG [claude args/prompt...]         run claude via the current account
  $PROG --tmux <name> [claude args...]  same, inside a new tmux window <name>
                                           (+ --name <name>) so tg-ctl reaches it;
                                           a plain interactive run outside tmux
                                           WARNS (CLAUDE_ROTATE_REQUIRE_TMUX=
                                           warn|wrap|off, default warn)
  $PROG rotate                          show accounts — an arrow-key picker
                                           at a real terminal (↑/↓ + Enter to
                                           switch, q/Esc to cancel), else the
                                           plain table
  $PROG accounts                        same as 'rotate' — a second,
                                           equally-safe top-level entry point;
                                           every subcommand below also works
                                           as '$PROG accounts <subcommand>'
  $PROG rotate list [--no-verify]       ALWAYS the plain table, never the
                                           picker. Live-verifies each account
                                           with one cheap $VERIFY_MODEL call by
                                           default; --no-verify skips that
  $PROG rotate accounts list [--no-verify]   same as 'rotate list'
  $PROG rotate use <name|N|login> [--relaunch-panes]
                                         force the current account (name,
                                           number, or login/email). Only
                                           affects the NEXT launch — see LIVE
                                           ACCOUNT SWITCHING below
  $PROG rotate next [--relaunch-panes]  force-advance to the next account
  $PROG rotate login [name...]          log into every not-yet-logged-in
  $PROG rotate relogin [name...]        account (or the given ones) — 'relogin'
                                           is just an alias for 'login'
  $PROG rotate --help                   this help

LIVE ACCOUNT SWITCHING: Claude Code binds the account at process launch and
never re-reads it, so a session already running (this pane or any other)
keeps its old account no matter what. 'use'/'next'/the picker detect every
OTHER tmux pane running claude and offer to relaunch them (Escape to safely
interrupt, verified idle, Ctrl-C twice to verify a real exit, then a clean
restart onto the new account) — at a terminal you get a y/N prompt, non-interactively
you get the list + instructions unless --relaunch-panes was passed. A
relaunched pane starts a BRAND NEW conversation (accounts don't share session
history). For the pane you're in, just run 'exec claude' yourself.

Accounts live under: $ACCOUNTS_ROOT/account-N/
State file:          $STATE_FILE
Log:                  $LOG_FILE

Every argument whose first word isn't 'rotate'/'accounts' (including a bare
-h/--help, -p "prompt", or no args) is forwarded to the real claude binary
untouched. See the header comment in $0 for the full reference.
EOF
}

rotate_dispatch() {
  local sub="${1:-accounts}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
    accounts)
      cmd_accounts "$@"
      ;;
    list)
      cmd_accounts list "$@"
      ;;
    use)
      cmd_use "$@"
      ;;
    next)
      cmd_next "$@"
      ;;
    login | relogin)
      cmd_login "$@"
      ;;
    --help | help | -h)
      cmd_rotate_help
      ;;
    *)
      echo "$PROG: unknown 'rotate' subcommand '$sub'. Run '$PROG rotate --help'." >&2
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  rotate)
    shift
    rotate_dispatch "$@"
    ;;
  accounts)
    shift
    rotate_dispatch "$@"
    ;;
  --tmux)
    # `claude-rotate --tmux <name> [claude args...]` → the same run, inside a new
    # tmux window named <name> and with `--name <name>` (see TMUX GUARD).
    shift
    if [[ -z "${1:-}" || "${1:-}" == -* ]]; then
      echo "$PROG: --tmux needs a window/agent name: $PROG --tmux <name> [claude args...]" >&2
      exit 1
    fi
    tmux_name="$1"; shift
    run_in_tmux_window "$tmux_name" "$@"
    exit $?
    ;;
  --rotate-setup | --rotate-status | --rotate-use | --rotate-next | --rotate-help)
    # Old flag-prefix interface, replaced today by the 'rotate'/'accounts'
    # subcommand namespace — without this, these silently forward to the
    # real claude binary and produce a confusing "unknown option" error
    # instead of a clear migration hint (review finding).
    echo "$PROG: '$1' was renamed — see '$PROG rotate --help' for the current commands (e.g. '$PROG rotate use', '$PROG rotate accounts')." >&2
    exit 1
    ;;
  *)
    main_run "$@"
    ;;
esac
