#!/usr/bin/env bash
# claude-rotate — run `claude` through one of several personal Claude.ai
# subscription accounts, auto-rotating to the next account when the active
# one hits its session/weekly usage limit.
#
# WHY THIS EXISTS
#   Claude Code has no built-in multi-account switch (`claude auth login`,
#   `claude auth logout`, `claude auth status` are the only auth subcommands).
#   The supported way to keep N separate logins side by side is to point
#   CLAUDE_CONFIG_DIR at a dedicated directory per account — each directory
#   holds that account's own credentials/settings, completely independent of
#   `~/.claude` (the directory the plain `claude` binary uses by default).
#   Switching accounts is a PROCESS-LAUNCH decision, not a mid-session
#   hot-swap: a running session lives in one config dir for its whole life.
#
# LAYOUT
#   ~/.claude-accounts/account-1/   CLAUDE_CONFIG_DIR for account 1
#   ~/.claude-accounts/account-2/   CLAUDE_CONFIG_DIR for account 2
#   ~/.claude-accounts/account-3/   CLAUDE_CONFIG_DIR for account 3
#   ~/.claude-accounts/current      state file: which account dir to try first
#   ~/.claude-accounts/rotate.log   append-only log of rotation/switch events
#   Add a 4th (or Nth) account by running: claude-rotate --rotate-setup account-4
#   — any `account-*` directory under ~/.claude-accounts is auto-discovered,
#   no script edit needed.
#
# USAGE
#   claude-rotate [claude args/prompt...]   run claude via the current account;
#                                            auto-rotate on a detected limit hit
#   claude-rotate --rotate-setup [name...]  interactively log into any
#                                            not-yet-authenticated account dirs
#                                            (defaults to account-1/2/3 the
#                                            first time, or to whatever's
#                                            already registered afterwards)
#   claude-rotate --rotate-status           show every account + which is current
#   claude-rotate --rotate-use <name>       force the current account (no launch)
#   claude-rotate --rotate-next             force-advance to the next account
#   claude-rotate --rotate-help             this help
#
#   Every OTHER argument (including a bare `-h`/`--help`, `-p "prompt"`, or no
#   args at all) is forwarded to the real `claude` binary untouched — the
#   --rotate-* flags are a private namespace chosen specifically so they can
#   never collide with a current or future `claude` CLI flag.
#
# HOW ROTATION IS TRIGGERED
#   The CURRENT account (persisted in the state file) is always tried FIRST —
#   this never force-rotates on a normal, successful call. A rotation only
#   happens when that attempt looks exhausted:
#     - non-interactive/piped calls (stdout not a TTY, e.g. `-p` / scripted
#       use): output is captured and scanned for limit/quota text
#       ("session limit", "weekly limit", "usage limit", "rate limit", "limit
#       reached", "quota exceeded", ...), OR
#     - ANY call: the process exits non-zero within CLAUDE_ROTATE_FAST_EXIT_SECS
#       (default 10s) of launch — a fast failure looks like an auth/limit
#       problem, not real work ending in error.
#   A Ctrl-C/SIGTERM exit (130/143) is never treated as exhaustion — that's
#   the user quitting, not a limit.
#   KNOWN LIMITATION: a limit hit deep into a long INTERACTIVE session (one
#   that doesn't crash the process) can't be detected this way — capturing an
#   interactive TUI's output to scan it would break the TUI itself, so the
#   interactive path only ever gets the "fast exit" signal, never text
#   matching. If Claude just refuses further turns without exiting, restart
#   the session (or run `claude-rotate --rotate-next` yourself) to force a
#   switch.
#   Non-interactive/piped output is merged (stdout+stderr) while captured for
#   scanning — a documented trade-off to keep the capture simple; a caller
#   relying on separate streams should not pipe through this wrapper.
#
# WIRING IT IN (so plain `claude` goes through rotation transparently)
#   A zsh alias `claude -> claude-rotate` is DEFINED (currently commented out
#   / disabled) in ~/.files/aliases.zsh — see the comment there for why an
#   alias (not PATH-shadowing the real binary) was chosen, and for why it's
#   disabled: it must not be enabled until at least one account is actually
#   set up below, or plain `claude` breaks entirely with "no accounts
#   registered".
#
# SETUP (do this once per new account slot — interactive, cannot be
# automated: it's a real browser OAuth login)
#   claude-rotate --rotate-setup
#
# State updates are NOT locked — concurrent claude-rotate invocations can
# race on the state file. Acceptable for a single personal user; not meant
# for heavy concurrent/background use.

set -uo pipefail
# NOTE: deliberately no `set -e` (errexit) — this script's whole job is to
# inspect and react to a child `claude` process's non-zero exit codes, which
# errexit would abort the script on before we get to look at them.

ACCOUNTS_ROOT="${CLAUDE_ROTATE_ROOT:-$HOME/.claude-accounts}"
STATE_FILE="$ACCOUNTS_ROOT/current"
LOG_FILE="$ACCOUNTS_ROOT/rotate.log"
FAST_EXIT_THRESHOLD="${CLAUDE_ROTATE_FAST_EXIT_SECS:-10}"
LIMIT_PATTERN='session limit|weekly limit|usage limit|rate.?limit|limit reached|quota exceeded|try again later|resets (at|in)'

# ---------------------------------------------------------------------------
# account registry helpers
# ---------------------------------------------------------------------------

# Prints registered account names (basenames of ~/.claude-accounts/account-*),
# one per line, sorted. The single source of truth for "what accounts exist" —
# adding a directory here is all it takes to register a new account.
list_accounts() {
  local d
  for d in "$ACCOUNTS_ROOT"/account-*/; do
    [[ -d "$d" ]] || continue
    basename "$d"
  done | sort -V
}

log_event() {
  mkdir -p "$ACCOUNTS_ROOT"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"
}

# Reads the persisted "current" account, falling back to the first registered
# account if the state file is missing/stale (points at a since-removed dir).
# Does not persist the fallback itself — callers persist whatever they end up
# actually using.
get_current_account() {
  local -a accounts=("$@")
  local saved="" a
  [[ -f "$STATE_FILE" ]] && saved="$(<"$STATE_FILE")"
  saved="${saved//[$'\t\r\n ']/}"
  for a in "${accounts[@]}"; do
    [[ "$a" == "$saved" ]] && { echo "$saved"; return; }
  done
  echo "${accounts[0]}"
}

set_current_account() {
  mkdir -p "$ACCOUNTS_ROOT"
  echo "$1" >"$STATE_FILE"
}

# Quick, cheap (no token spend) check of whether an account dir is logged in.
is_account_logged_in() {
  local dir="$1"
  CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null | grep -q '"loggedIn": *true'
}

# Rotates $accounts so it starts at $current and wraps around — the order in
# which run_with_rotation() tries accounts this invocation.
rotation_order() {
  local current="$1"; shift
  local -a accounts=("$@")
  local i start=0
  for i in "${!accounts[@]}"; do
    [[ "${accounts[$i]}" == "$current" ]] && { start=$i; break; }
  done
  local n=${#accounts[@]} j
  for ((j = 0; j < n; j++)); do
    echo "${accounts[$(((start + j) % n))]}"
  done
}

# ---------------------------------------------------------------------------
# running claude and judging the result
# ---------------------------------------------------------------------------

# Runs `claude "$@"` against $1's config dir, sets the globals LAST_EXIT_CODE,
# LAST_ELAPSED (seconds), LAST_OUTPUT_MATCHED (1 if limit text was seen —
# only possible on the non-TTY path, see header comment).
run_claude_once() {
  local dir="$1"; shift
  local start end rc
  start=$(date +%s)
  if [[ -t 1 ]]; then
    # Interactive: full TTY passthrough, no capture (capturing would break
    # the TUI). Only the exit code + timing are usable signals here.
    CLAUDE_CONFIG_DIR="$dir" claude "$@"
    rc=$?
    LAST_OUTPUT_MATCHED=0
  else
    # Non-interactive/piped: capture (stdout+stderr merged, see header
    # comment) so it can both be scanned for limit text AND still reach the
    # real caller. The pipeline blocks until `tee` has fully drained, so
    # there's no race reading the temp file right after.
    local combined
    combined="$(mktemp)"
    CLAUDE_CONFIG_DIR="$dir" claude "$@" 2>&1 | tee "$combined"
    rc=${PIPESTATUS[0]}
    if grep -Eiq "$LIMIT_PATTERN" "$combined" 2>/dev/null; then
      LAST_OUTPUT_MATCHED=1
    else
      LAST_OUTPUT_MATCHED=0
    fi
    rm -f "$combined"
  fi
  end=$(date +%s)
  LAST_EXIT_CODE=$rc
  LAST_ELAPSED=$((end - start))
}

# True if this attempt's result looks like exhaustion (limit text seen, or a
# non-zero exit that came back fast) rather than a real, unrelated error.
looks_exhausted() {
  [[ "${LAST_OUTPUT_MATCHED:-0}" -eq 1 ]] && return 0
  [[ "$LAST_EXIT_CODE" -ne 0 && "$LAST_ELAPSED" -lt "$FAST_EXIT_THRESHOLD" ]] && return 0
  return 1
}

# ---------------------------------------------------------------------------
# main: try the current account, rotate forward on exhaustion
# ---------------------------------------------------------------------------

main_run() {
  mkdir -p "$ACCOUNTS_ROOT"
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  if [[ ${#accounts[@]} -eq 0 ]]; then
    echo "claude-rotate: no accounts registered under $ACCOUNTS_ROOT." >&2
    echo "Run 'claude-rotate --rotate-setup' first." >&2
    exit 1
  fi

  local current
  current="$(get_current_account "${accounts[@]}")"
  local -a order
  mapfile -t order < <(rotation_order "$current" "${accounts[@]}")

  local i acct next_acct
  for i in "${!order[@]}"; do
    acct="${order[$i]}"

    # Only pre-check login state for accounts we're rotating INTO after a
    # failure — the first (current) attempt skips this to keep the common
    # happy path at zero extra overhead. An unauthenticated current account
    # will simply fail on its own (interactively: claude shows its native
    # login screen; non-interactively: a fast auth error, which the
    # fast-exit heuristic below already rotates past).
    if [[ $i -gt 0 ]] && ! is_account_logged_in "$ACCOUNTS_ROOT/$acct"; then
      log_event "skip $acct: not logged in"
      continue
    fi

    [[ $i -gt 0 ]] && echo "claude-rotate: switching to $acct (previous account looked exhausted)" >&2

    run_claude_once "$ACCOUNTS_ROOT/$acct" "$@"

    if [[ "$LAST_EXIT_CODE" -eq 130 || "$LAST_EXIT_CODE" -eq 143 ]]; then
      # user hit Ctrl-C / process was killed — not exhaustion, don't rotate
      set_current_account "$acct"
      exit "$LAST_EXIT_CODE"
    fi

    if [[ "$LAST_EXIT_CODE" -eq 0 ]] || ! looks_exhausted; then
      # success, or a genuine unrelated error — either way this is where we
      # land; don't mask a real bug by cycling through every other account
      set_current_account "$acct"
      exit "$LAST_EXIT_CODE"
    fi

    log_event "rotate: $acct looked exhausted (exit=$LAST_EXIT_CODE elapsed=${LAST_ELAPSED}s text_match=${LAST_OUTPUT_MATCHED:-0})"
    next_acct="${order[$((i + 1))]:-}"
    [[ -n "$next_acct" ]] && set_current_account "$next_acct"
  done

  echo "claude-rotate: every registered, logged-in account looked exhausted." >&2
  echo "Try again later, or run 'claude-rotate --rotate-status'." >&2
  exit 1
}

# ---------------------------------------------------------------------------
# --rotate-* subcommands
# ---------------------------------------------------------------------------

cmd_setup() {
  mkdir -p "$ACCOUNTS_ROOT"
  local -a targets=("$@")
  if [[ ${#targets[@]} -eq 0 ]]; then
    mapfile -t targets < <(list_accounts)
    [[ ${#targets[@]} -eq 0 ]] && targets=(account-1 account-2 account-3)
  fi

  local a dir
  for a in "${targets[@]}"; do
    if [[ "$a" != account-* ]]; then
      echo "claude-rotate: '$a' doesn't match the required 'account-<name>' naming (e.g. account-4) — skipping, since list_accounts() only auto-discovers 'account-*' directories." >&2
      continue
    fi
    dir="$ACCOUNTS_ROOT/$a"
    mkdir -p "$dir"
    echo
    if is_account_logged_in "$dir"; then
      echo "== $a: already logged in =="
      CLAUDE_CONFIG_DIR="$dir" claude auth status --text 2>/dev/null || true
      continue
    fi
    echo "== $a: not logged in. Starting interactive login (opens a browser)... =="
    echo "   config dir: $dir"
    CLAUDE_CONFIG_DIR="$dir" claude auth login --claudeai
    if is_account_logged_in "$dir"; then
      echo "== $a: login verified =="
      log_event "setup: $a logged in"
    else
      echo "== $a: still not logged in after that — rerun 'claude-rotate --rotate-setup $a' to retry ==" >&2
    fi
  done

  [[ -f "$STATE_FILE" ]] || {
    local -a all
    mapfile -t all < <(list_accounts)
    [[ ${#all[@]} -gt 0 ]] && set_current_account "${all[0]}"
  }
}

cmd_status() {
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  if [[ ${#accounts[@]} -eq 0 ]]; then
    echo "No accounts registered yet. Run 'claude-rotate --rotate-setup'."
    return
  fi
  local current
  current="$(get_current_account "${accounts[@]}")"

  local a dir marker json logged_in email sub
  for a in "${accounts[@]}"; do
    dir="$ACCOUNTS_ROOT/$a"
    marker=" "
    [[ "$a" == "$current" ]] && marker="*"
    json="$(CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null)"
    logged_in="$(printf '%s' "$json" | grep -o '"loggedIn": *[a-z]*' | grep -o '[a-z]*$')"
    if [[ "$logged_in" == "true" ]]; then
      email="$(printf '%s' "$json" | grep -o '"email": *"[^"]*"' | cut -d'"' -f4)"
      sub="$(printf '%s' "$json" | grep -o '"subscriptionType": *"[^"]*"' | cut -d'"' -f4)"
      echo "$marker $a   logged in   ${email:-(no email)}   (${sub:-unknown plan})"
    else
      echo "$marker $a   NOT logged in — run: claude-rotate --rotate-setup $a"
    fi
  done
  echo
  echo "* = current account (tried first on the next 'claude-rotate' run)"
}

cmd_use() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo "claude-rotate: --rotate-use needs an account name, e.g. 'claude-rotate --rotate-use account-2'" >&2
    exit 1
  fi
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  local a
  for a in "${accounts[@]}"; do
    if [[ "$a" == "$target" ]]; then
      set_current_account "$target"
      log_event "manual switch -> $target"
      echo "claude-rotate: current account set to $target"
      return 0
    fi
  done
  echo "claude-rotate: unknown account '$target'. Known: ${accounts[*]:-(none registered)}" >&2
  exit 1
}

cmd_next() {
  local -a accounts
  mapfile -t accounts < <(list_accounts)
  if [[ ${#accounts[@]} -eq 0 ]]; then
    echo "claude-rotate: no accounts registered." >&2
    exit 1
  fi
  local current i next_idx=0
  current="$(get_current_account "${accounts[@]}")"
  for i in "${!accounts[@]}"; do
    [[ "${accounts[$i]}" == "$current" ]] && { next_idx=$(((i + 1) % ${#accounts[@]})); break; }
  done
  set_current_account "${accounts[$next_idx]}"
  log_event "manual force-next -> ${accounts[$next_idx]}"
  echo "claude-rotate: current account set to ${accounts[$next_idx]}"
}

cmd_help() {
  # Quick reference — the header comment at the top of this file has the
  # full explanation (detection rules, wiring, limitations).
  cat <<EOF
claude-rotate — run claude through one of several personal accounts,
auto-rotating on a detected session/weekly limit hit.

  claude-rotate [claude args/prompt...]   run claude via the current account
  claude-rotate --rotate-setup [name...]  interactively log into account dirs
  claude-rotate --rotate-status           show all accounts + which is current
  claude-rotate --rotate-use <name>       force the current account
  claude-rotate --rotate-next             force-advance to the next account
  claude-rotate --rotate-help             this help

Accounts live under: $ACCOUNTS_ROOT/account-N/
State file:          $STATE_FILE
Log:                  $LOG_FILE

Every other argument (including a bare -h/--help or no args) is forwarded to
the real claude binary untouched. See the header comment in
$0 for the full reference.
EOF
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  --rotate-setup)
    shift
    cmd_setup "$@"
    ;;
  --rotate-status)
    cmd_status
    ;;
  --rotate-use)
    shift
    cmd_use "$@"
    ;;
  --rotate-next)
    cmd_next
    ;;
  --rotate-help)
    cmd_help
    ;;
  *)
    main_run "$@"
    ;;
esac
