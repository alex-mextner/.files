# macOS machine config. Everything portable (behaviour, colours, most aliases) lives in
# .gitconfig.shared, which Ubuntu machines include from their own ~/.gitconfig as well.
[include]
	path = ~/.files/.gitconfig.shared

[user]
  name = Alex Ultra
  email = invntrm@icloud.com
	signingkey = D8432C6E26F51925
[core]
	editor = "code --wait --new-window "
	excludesfile = ~/.gitignore
	pager = diff-so-fancy | less --tabs=4 -RFX
	compression = 0

[merge]
	tool = vscode

[mergetool "ws"]
	cmd = webide merge $(cd $(dirname "$LOCAL") && pwd)/$(basename "$LOCAL") $(cd $(dirname "$REMOTE") && pwd)/$(basename "$REMOTE") $(cd $(dirname "$BASE") && pwd)/$(basename "$BASE") $(cd $(dirname "$MERGED") && pwd)/$(basename "$MERGED")
	trustExitCode = true

[mergetool "splice"]
	cmd = "vim -f $BASE $LOCAL $REMOTE $MERGED -c 'SpliceInit'"
	trustExitCode = true

[mergetool "vscode"]
	cmd = code --wait $MERGED #"cursor --wait "

[difftool "ws"]
	cmd = webide diff $(cd $(dirname "$LOCAL") && pwd)/$(basename "$LOCAL") $(cd $(dirname "$REMOTE") && pwd)/$(basename "$REMOTE")
	trustExitCode = true

[difftool "vsc-difftool"]
  cmd = code --wait --diff $LOCAL $REMOTE

[diff]
  tool = vsc-difftool
	noprefix = true # remove a/ b/ from diff

[alias]
	undo = !/opt/homebrew/bin/legit undo
	open = "!open $(gh-get-pr-by-branch $(git-get-br))"
	switch = !legit switch
	sw = !legit switch
	sync = !/opt/homebrew/bin/legit sync
	publish = !/opt/homebrew/bin/legit publish
	unpublish = !/opt/homebrew/bin/legit unpublish
	branches = !/opt/homebrew/bin/legit branches

	# clean-branches-dryrun = "!git branch --merged | egrep -v '(^\*|master|dev)' | xargs echo git branch -d"

# Put your name and email, and so on into ~/.config/git/config
# Not HERE

#[filter "lfs"]
#	smudge = git-lfs smudge --skip %f
#	required = true
#	clean = git-lfs clean -- %f

# [lfs]
# 	batch = true
# 	concurrenttransfers = 15

[commit]
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	program = /opt/homebrew/bin/gpg
[safe]
	directory = /tmp/ntgcalls-debug
	directory = /private/tmp/ntgcalls-debug
[diff "lockb"]
	textconv = bun
	binary = true
