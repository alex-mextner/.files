[Desktop Entry]
Type=Application
Name=ChatGPT
Comment=ChatGPT in a standalone window
# The shell, not the desktop file parser, expands $HOME (same two quoting layers as finish-setup.desktop). The launcher script
# ~/.local/bin/chatgpt-window picks the Chrome and keeps the window's own profile in ~/.config/chatgpt-app.
Exec=sh -c "exec \\"\\$HOME/.local/bin/chatgpt-window\\""
# Icon: the theme name chatgpt-window, found in ~/.local/share/icons/hicolor/{48x48,256x256}/apps (tracked PNGs). The 256x256 one is
# https://chatgpt.com/cdn/assets/favicon.6a33781f61.svg (the site's own vector logo) as a white glyph on a black rounded square,
# rendered with headless Chrome; OpenAI's official icon URL answers 404.
# Own name so it never shadows the icon of the ChatGPT desktop app package.
Icon=chatgpt-window
Terminal=false
Categories=Network;
StartupWMClass=ChatGPT
