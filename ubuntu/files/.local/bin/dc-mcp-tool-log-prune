#!/bin/bash
# dc-mcp-tool-log-prune [--dry-run] [DIR]: retention for Desktop Commander's own tool-call log.
#
# Desktop Commander rotates ~/.claude-server-commander/claude_tool_call.log at 10 MB into claude_tool_call_<date>_<time>.log and its
# README says it never deletes a rotated file. This keeps the newest KEEP rotated files that are also younger than MAX_AGE_DAYS
# and removes the rest. It never touches the active claude_tool_call.log, never follows symlinks, only names that match the
# rotated pattern exactly, and a second run finds nothing to do. Run daily by dc-mcp-tool-log-prune.timer; the server is not touched.
#
#   DIR   default $DC_MCP_TOOL_LOG_DIR, else ~/.claude-server-commander (a missing directory is not an error: nothing to do)
#   DC_MCP_TOOL_LOG_KEEP          rotated files kept, default 5
#   DC_MCP_TOOL_LOG_MAX_AGE_DAYS  older rotated files go, default 30
set -u
dry=
if [ "${1:-}" = "--dry-run" ]; then dry=1; shift; fi
dir=${1:-${DC_MCP_TOOL_LOG_DIR:-$HOME/.claude-server-commander}}
keep=${DC_MCP_TOOL_LOG_KEEP:-5}
max_age=${DC_MCP_TOOL_LOG_MAX_AGE_DAYS:-30}
case "$keep" in ''|*[!0-9]*) echo "dc-mcp-tool-log-prune: DC_MCP_TOOL_LOG_KEEP must be a number: $keep" >&2; exit 2 ;; esac
case "$max_age" in ''|*[!0-9]*) echo "dc-mcp-tool-log-prune: DC_MCP_TOOL_LOG_MAX_AGE_DAYS must be a number: $max_age" >&2; exit 2 ;; esac
[ -d "$dir" ] || exit 0

rotated='^claude_tool_call_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}\.log$'
cutoff=$(( $(date +%s) - max_age * 86400 ))
rank=0 removed=0 failed=0
# newest first; NUL separated so a name with spaces or glob characters stays one name
while IFS= read -r -d '' entry; do
  mtime=${entry%% *}; file=${entry#* }
  base=${file##*/}
  [[ $base =~ $rotated ]] || continue
  rank=$((rank + 1))
  if [ "$rank" -gt "$keep" ] || [ "${mtime%.*}" -lt "$cutoff" ]; then
    if [ -n "$dry" ]; then echo "would remove $file"; removed=$((removed + 1))
    elif rm -f -- "$file"; then echo "removed $file"; removed=$((removed + 1))
    else echo "dc-mcp-tool-log-prune: cannot remove $file" >&2; failed=$((failed + 1)); fi
  fi
done < <(find "$dir" -maxdepth 1 -type f -name 'claude_tool_call_*.log' -printf '%T@ %p\0' | sort -z -rn)
echo "dc-mcp-tool-log-prune: $dir: $removed rotated file(s) ${dry:+would be }removed, keep $keep newest within $max_age days"
[ "$failed" -eq 0 ] || { echo "dc-mcp-tool-log-prune: $failed file(s) could not be removed" >&2; exit 1; }
