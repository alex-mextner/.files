#!/usr/bin/env python3
"""who-ran: which omp session ran the heavy thing? (forensics for memory incidents, OPEN-ISSUES.md #6)

  who-ran --since '2026-10-11 13:30' [--until '2026-10-11 13:40'] [--pattern REGEX] [--tz local|utc]
      scan ~/.omp/agent/sessions/**/*.jsonl for bash/eval tool calls in the window matching PATTERN
  who-ran --live [--pattern REGEX] [--steer 'message']
      heavy processes running now, with the omp session that owns them; --steer messages every owner

Exit codes: 0 found, 1 nothing found, 2 bad arguments.
"""
import argparse
import datetime as dt
import json
import os
import re
import signal
import subprocess
import sys
import time

SESSIONS_DIR = os.path.expanduser("~/.omp/agent/sessions")
DEFAULT_PATTERN = r"pytest|bun test|vitest|jest|mypy|tsc|cargo test|go test|docker (run|build|compose)|review diff|scripts/check"
GB = 1024 ** 3


def die(msg):
    sys.stderr.write(f"who-ran: {msg}\n")
    sys.exit(2)


def parse_when(s, tz):
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M", "%Y-%m-%d"):
        try:
            d = dt.datetime.strptime(s, fmt)
            break
        except ValueError:
            continue
    else:
        die(f"cannot parse time {s!r} (want 'YYYY-MM-DD HH:MM[:SS]')")
    return d.replace(tzinfo=dt.timezone.utc) if tz == "utc" else d.astimezone()


def fmt_when(d, tz):
    d = d.astimezone(dt.timezone.utc) if tz == "utc" else d.astimezone()
    return d.strftime("%H:%M:%S")


def iso(ts):
    return dt.datetime.fromisoformat(ts.replace("Z", "+00:00"))


def live_sessions():
    """{pid: host} from tg-ctl omp-live status (what omp-steer list prints); empty when unavailable."""
    try:
        r = subprocess.run(["tg-ctl", "omp-live", "status", "--json"], capture_output=True, text=True, timeout=20)
        return {int(h["pid"]): h for h in json.loads(r.stdout or "[]")}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


# ----------------------------------------------------------------------------- transcript scan
_title_cache = {}


def root_title(root_file):
    if root_file not in _title_cache:
        title = ""
        try:
            with open(root_file, errors="replace") as f:
                for line in f:
                    if line.startswith('{"type":"title'):
                        try:
                            title = json.loads(line).get("title") or title
                        except ValueError:
                            pass
        except OSError:
            pass
        _title_cache[root_file] = title
    return _title_cache[root_file]


def scan_file(path, since, until, pattern):
    """Matching (when, command) tool calls in one transcript. eval code lives in the toolResult
    message (the start event only carries the intent), so the file is read in one pass and
    eval starts are resolved at the end."""
    hits, pending_eval = [], {}
    try:
        f = open(path, errors="replace")
    except OSError:
        return hits
    with f:
        for line in f:
            if '"tool_execution_start"' in line:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                data = ev.get("data") or {}
                tool = data.get("toolName")
                if tool not in ("bash", "eval"):
                    continue
                try:
                    when = iso(ev.get("timestamp") or data.get("startedAt"))
                except (ValueError, AttributeError):
                    continue
                if when < since or when > until:
                    continue
                args = data.get("args") or {}
                cmd = args.get("command") or args.get("code") or ""
                if tool == "eval" and not cmd:
                    pending_eval[data.get("toolCallId")] = (when, data.get("intent") or "")
                    continue
                if pattern.search(cmd):
                    hits.append((when, cmd))
            elif pending_eval and '"toolResult"' in line and '"toolName":"eval"' in line:
                try:
                    msg = json.loads(line).get("message") or {}
                except ValueError:
                    continue
                key = msg.get("toolCallId")
                if key in pending_eval:
                    when, intent = pending_eval.pop(key)
                    code = "\n".join(c.get("code", "") for c in (msg.get("details") or {}).get("cells", []))
                    if pattern.search(code or intent):
                        hits.append((when, f"eval: {code or intent}"))
    for when, intent in pending_eval.values():       # no result recorded (still running / crashed)
        if pattern.search(intent):
            hits.append((when, f"eval: {intent}"))
    return hits


def scan(args, pattern):
    since = parse_when(args.since, args.tz)
    until = parse_when(args.until, args.tz) if args.until else dt.datetime.now(dt.timezone.utc)
    if until < since:
        die("--until is before --since")
    live = live_sessions()
    live_files = {h.get("sessionFile") for h in live.values()}
    live_ids = {h.get("sessionId") for h in live.values()}
    rows = []
    for dirpath, _, files in os.walk(SESSIONS_DIR):
        for name in files:
            if not name.endswith(".jsonl"):
                continue
            path = os.path.join(dirpath, name)
            try:
                if os.stat(path).st_mtime < since.timestamp():
                    continue
            except OSError:
                continue
            rel = os.path.relpath(path, SESSIONS_DIR).split(os.sep)
            slug = rel[0]
            if len(rel) == 2:                     # <slug>/<ISO>_<sid>.jsonl  (root session)
                root, sub = path, "-"
            elif len(rel) == 3:                   # <slug>/<ISO>_<sid>/<Subagent>.jsonl
                root, sub = os.path.join(SESSIONS_DIR, slug, rel[1] + ".jsonl"), rel[2][:-6]
            else:
                continue
            sid = os.path.basename(root)[:-6].split("_", 1)[-1]
            is_live = "live" if root in live_files or sid in live_ids else "gone"
            for when, cmd in scan_file(path, since, until, pattern):
                rows.append((when, root_title(root), sub, slug, is_live, cmd))
    rows.sort(key=lambda r: r[0])
    for when, title, sub, slug, is_live, cmd in rows:
        cmd = " ".join(cmd.split())[:160]
        print(f"{fmt_when(when, args.tz)}  {title[:40]:40}  {sub[:22]:22}  {slug[:28]:28}  {is_live:4}  {cmd}")
    return 0 if rows else 1


# ----------------------------------------------------------------------------- live processes
def live_procs(pattern):
    page = os.sysconf("SC_PAGE_SIZE")
    hz = os.sysconf("SC_CLK_TCK")
    btime = 0
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("btime"):
                btime = int(line.split()[1])
    procs = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(f"/proc/{name}/stat") as f:
                stat = f.read()
            with open(f"/proc/{name}/cmdline", "rb") as f:
                cmdline = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        except OSError:
            continue
        rp = stat.rfind(")")
        fields = stat[rp + 2:].split()
        procs[int(name)] = dict(ppid=int(fields[1]), rss=int(fields[21]) * page,
                                start=btime + int(fields[19]) / hz, cmd=cmdline)
    return procs


def owner_of(pid, procs, live):
    seen = set()
    while pid in procs and pid not in seen:
        seen.add(pid)
        if pid in live:
            return pid
        pid = procs[pid]["ppid"]
    return None


def show_live(args, pattern):
    procs = live_procs(pattern)
    live = live_sessions()
    me = os.getpid()
    rows = []
    for pid, p in procs.items():
        if pid == me or not p["cmd"] or not pattern.search(p["cmd"]):
            continue
        owner = owner_of(pid, procs, live)
        rows.append((p["rss"], pid, time.time() - p["start"], owner, p["cmd"]))
    rows.sort(reverse=True)
    owners = set()
    for rss, pid, age, owner, cmd in rows:
        h = live.get(owner) or {}
        who = f"omp {owner} {h.get('cwd', '')} {h.get('title') or ''}".strip() if owner else "no live omp owner"
        print(f"{pid:>7}  {rss / GB:5.1f}G  {int(age) // 60:4}m{int(age) % 60:02}s  {who[:60]:60}  {' '.join(cmd.split())[:120]}")
        if owner:
            owners.add(owner)
    if args.steer:
        for owner in sorted(owners):
            r = subprocess.run(["omp-steer", str(owner), args.steer], capture_output=True, text=True, timeout=60)
            print(f"steer {owner}: {(r.stdout.strip() or r.stderr.strip())[:200]}")
    return 0 if rows else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since")
    ap.add_argument("--until")
    ap.add_argument("--pattern", default=DEFAULT_PATTERN, help="regex (default: common heavy commands)")
    ap.add_argument("--tz", choices=("local", "utc"), default="local")
    ap.add_argument("--live", action="store_true", help="heavy processes running now and their owning session")
    ap.add_argument("--steer", metavar="MSG", help="with --live: send MSG to every owner session via omp-steer")
    args = ap.parse_args()
    try:
        pattern = re.compile(args.pattern)
    except re.error as e:
        die(f"bad --pattern: {e}")
    if args.steer and not args.live:
        die("--steer needs --live")
    if args.live:
        if args.since or args.until:
            die("--live does not take --since/--until")
        return show_live(args, pattern)
    if not args.since:
        die("--since is required (or use --live)")
    return scan(args, pattern)

if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # `who-ran ... | head` must not traceback
    sys.exit(main())
