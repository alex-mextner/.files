[Unit]
Description=Poll the router into the network device inventory once an hour
# The Ubee web server hangs when polled often. The router is polled ONLY by this timer and
# by the manual "Обновить" button (ha-host-actions POST /network/update). Keep it hourly.

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=2min
AccuracySec=1min

[Install]
WantedBy=timers.target
