#!/usr/bin/env python3
"""guardian-connect: one-command private Guardian connector setup for ChatGPT (stdlib only).

Interactive mode (the default) walks the owner through: verifying the already-installed pm
connector, collecting the non-secret tunnel id and the restricted runtime API key (getpass only),
encrypting the key with ``systemd-creds`` into a private file, creating the tunnel-client profile
``pm-guardian``, installing a user systemd unit, running ``tunnel-client doctor`` and only then
starting the worker. ``--run-service`` is the unit's entry point: it reads the decrypted
credential from ``$CREDENTIALS_DIRECTORY``, exposes it to tunnel-client as
``CONTROL_PLANE_API_KEY`` and execs ``tunnel-client run``. ``--check`` reports state read-only.

The key never appears in argv, config files, logs or output. User-facing prompts are Russian
and stored as Unicode escapes because the repository forbids non-ASCII text.
"""

from __future__ import annotations

import argparse
import dataclasses
import getpass
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time
from collections.abc import Callable, Mapping
from pathlib import Path
from typing import TextIO

PROFILE = "pm-guardian"
CREDENTIAL_NAME = "guardian-tunnel-key"
CREDENTIAL_FILE = "tunnel-key.cred"
UNIT_NAME = "guardian-tunnel.service"
HEALTH_ADDR = "127.0.0.1:8793"
HEALTH_URL = f"http://{HEALTH_ADDR}/health"
READY_TIMEOUT_S = 90.0  # first control-plane long poll can take ~35s plus startup/jitter
READY_POLL_S = 2.0
HEALTH_CMD_TIMEOUT_S = 10.0

STATE_UNAVAILABLE = "unavailable"
STATE_NOT_READY = "not_ready"
STATE_AWAITING_POLL = "awaiting_poll"
STATE_READY = "ready"
KEY_ENV = "CONTROL_PLANE_API_KEY"
TUNNEL_ID_RE = re.compile(r"tunnel_(?:[a-z0-9]{4}_)?[a-z0-9]{32}")
TUNNELS_URL = "https://platform.openai.com/settings/organization/tunnels"
DISPLAY_LIMIT = 1500

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_USAGE = 2
EXIT_NOT_READY = 3

