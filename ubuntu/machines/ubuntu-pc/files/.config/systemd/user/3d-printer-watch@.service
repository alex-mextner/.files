[Unit]
Description=3D printer watch %i on ubuntu-pc (live monitoring, delivery held)
Documentation=https://github.com/alex-mextner/3d-cli/blob/main/docs/commands/printer.md
After=network-online.target

[Service]
Type=simple
Environment=PATH=/home/ultra/xp/3d-cli/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ultra/xp/3d-cli/.venv/bin/python /home/ultra/xp/3d-cli/bin/3d printer watch %i --dry-run
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
