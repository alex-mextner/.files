#!/usr/bin/env bash
# tmux-autosave: fire tmux-continuum's autosave from a systemd timer instead of from tmux's status line.
#
# continuum's autosave trigger is a `#(continuum_save.sh)` token it appends to the global `status-right` ONCE, when the
# plugin loads. tmux evaluates it only while a client is attached and drawing, and anything that rewrites status-right
# afterwards removes it for good. On this PC the Moshi iOS client does exactly that on every attach
# (`tmux set -g status-right '' ; attach-session`, global, so it wipes the token for every client until the server
# restarts), and a server with no client attached never draws a status line at all. Result: no snapshot between
# 2026-10-23 and the 2026-11-08 reboot, so the reboot restored a 16-day-old layout and no omp/claude/codex map existed.
#
# This script runs continuum's OWN save entry point (continuum_save.sh: save interval, lock, last-save timestamp, then
# tmux-resurrect's save.sh and rig's post-save-all hooks that write the omp/cc/codex session maps) from the timer. The
# trigger no longer depends on status-right or on a client, and there is still exactly one saver pipeline: continuum's
# interval check decides whether a run saves, so a 5-minute timer yields a save every @continuum-save-interval minutes.
#
# It only acts on a server in which continuum initialised its autosave (it stamps @continuum-save-last-timestamp at
# load). continuum deliberately skips that when another tmux server is running at load, so that two servers never
# overwrite each other's snapshot in the shared resurrect directory; this script keeps that rule instead of bypassing it.
#
# continuum starts resurrect's save in the background and discards its output, so success is verified here: when a run
# triggered a save, tmux-resurrect must touch its snapshot directory within TMUX_AUTOSAVE_SAVE_WAIT seconds.
#
# Exit 0: a save is current (or not needed yet), or there is no server to save. Exit 1: autosave is NOT working
# (continuum inactive in the server, no saver, unwritable snapshot directory, a save that wrote nothing, or no save
# for TMUX_AUTOSAVE_STALE_MIN minutes); the unit then shows as failed in `systemctl --user --failed` and the reason is
# in `journalctl --user -u tmux-autosave`.
#
#   TMUX_AUTOSAVE_TMUX            tmux executable, one word (default tmux); tests point it at a throwaway socket
#   TMUX_AUTOSAVE_CONTINUUM_SAVE  continuum's save script (default ~/.tmux/plugins/tmux-continuum/scripts/continuum_save.sh)
#   TMUX_AUTOSAVE_STALE_MIN       minutes without a save after which the run fails (default 45 = three save intervals; a
#                                 longer @continuum-save-interval raises the limit to three of its intervals)
#   TMUX_AUTOSAVE_SAVE_WAIT       seconds to wait for a triggered save to show up in the snapshot directory (default 30)
set -u

tmux_bin=${TMUX_AUTOSAVE_TMUX:-tmux}
continuum_save=${TMUX_AUTOSAVE_CONTINUUM_SAVE:-$HOME/.tmux/plugins/tmux-continuum/scripts/continuum_save.sh}
fail() { echo "tmux-autosave: $*" >&2; exit 1; }

# a monotonic-enough microsecond clock: whole-second timestamps would cut the save-wait allowance short by almost a second
now_us() { local t=$EPOCHREALTIME; printf '%s' "${t/[.,]/}"; }

# the directory rule, the save fingerprint and the number normalisation are shared with tmux-boot (tmux-lib, next to this script)
lib=$(dirname "$(readlink -f "$0")")/tmux-lib
# shellcheck source=tmux-lib
. "$lib" || fail "cannot load $lib"

# a leading zero ("08") is a decimal number here, not a bad octal one: tmux-lib's one normalisation guards the
# environment numbers too (validated in this shell: a `exit 2` inside $( ) would only leave the subshell)
stale_min=${TMUX_AUTOSAVE_STALE_MIN:-45}
save_wait=${TMUX_AUTOSAVE_SAVE_WAIT:-30}
if ! norm=$(tl_number "$stale_min"); then
  echo "tmux-autosave: TMUX_AUTOSAVE_STALE_MIN must be a whole number of minutes, got '$stale_min'" >&2
  exit 2
fi
stale_min=$norm
if ! norm=$(tl_number "$save_wait"); then
  echo "tmux-autosave: TMUX_AUTOSAVE_SAVE_WAIT must be a whole number of seconds, got '$save_wait'" >&2
  exit 2
fi
save_wait=$norm

# a systemd user manager hands out a minimal PATH: add the user's tool dirs after it, as tmux-boot does, so the hooks
# continuum's save script runs (rig, tg-ctl, lsof) resolve the same way as in a login shell
export PATH="$PATH:$HOME/.local/bin:$HOME/.bun/bin:/home/linuxbrew/.linuxbrew/bin"
# always the default socket (or the one TMUX_AUTOSAVE_TMUX names), never whichever server a calling pane belongs to
unset TMUX

command -v "$tmux_bin" >/dev/null 2>&1 || fail "tmux is not installed"
if ! "$tmux_bin" list-sessions >/dev/null 2>&1; then
  echo "tmux-autosave: no tmux server, nothing to save"
  exit 0
fi

# The server-side triggers that survive what wipes continuum's status-right token are put (back) in place on every run:
# continuum's own trigger goes through the guard (@resurrect-save-script-path -> tmux-resurrect-save) and the layout
# hooks run the debounced save. Idempotent; a run that finds them right prints and changes nothing.
while IFS= read -r line; do [ -z "$line" ] || echo "tmux-autosave: reasserted: $line"; done < <(tl_assert_saver; tl_assert_hooks)
[ -x "$continuum_save" ] || fail "tmux-continuum is not installed ($continuum_save)"

interval=$(tl_option @continuum-save-interval)
interval=${interval:-15}
if ! norm=$(tl_number "$interval"); then
  fail "@continuum-save-interval is '$interval', continuum wants a whole number of minutes"
fi
interval=$norm
if [ "$interval" = 0 ]; then
  echo "tmux-autosave: @continuum-save-interval is 0, autosave is switched off on purpose"
  exit 0
fi

before=$(tl_option @continuum-save-last-timestamp)
case $before in
  ''|*[!0-9]*) fail "tmux-continuum is not active in this server: it was not loaded (the server was started without ~/.tmux.conf?) or it skipped autosave because another tmux server was running when it loaded, so nothing is autosaved" ;;
esac

saver=$(tl_option @resurrect-save-script-path)
[ -n "$saver" ] && [ -x "$saver" ] || fail "tmux-resurrect's save script is missing (@resurrect-save-script-path='$saver')"
rdir=$(tl_resurrect_dir)
{ mkdir -p "$rdir" 2>/dev/null && [ -w "$rdir" ]; } || fail "the snapshot directory $rdir cannot be written"

# run-shell executes in the server, which also gives continuum's script the TMUX variable it names its lock after
sig_before=$(tl_save_signature "$rdir")
"$tmux_bin" run-shell "'$continuum_save'" || fail "tmux run-shell $continuum_save failed"

last=$(tl_option @continuum-save-last-timestamp)
case $last in ''|*[!0-9]*) last=$before ;; esac
if [ "$last" != "$before" ]; then
  # this run triggered a save, which runs in the background: wait until resurrect changed what it keeps in its
  # directory (a new or replaced snapshot, the pane archive, `last`). The fingerprint was taken just before the trigger,
  # so a directory that already existed, or was created, in the same second proves nothing: only a change counts.
  # a monotonic-enough clock, defined next to fail() above
  deadline=$(( $(now_us) + save_wait * 1000000 ))
  while [ "$(tl_save_signature "$rdir")" = "$sig_before" ] && [ "$(now_us)" -lt "$deadline" ]; do sleep 0.25; done
  [ "$(tl_save_signature "$rdir")" != "$sig_before" ] || fail "continuum started a save but tmux-resurrect wrote nothing into $rdir within $save_wait seconds"
fi

# three save intervals without a save is the failure, whatever the interval is (and never less than stale_min)
limit=$((stale_min * 60))
[ $((interval * 180)) -le "$limit" ] || limit=$((interval * 180))
age=$(( $(date +%s) - last ))
if [ "$age" -gt "$limit" ]; then
  fail "the last autosave was $((age / 60)) minutes ago (> $((limit / 60))): continuum refuses to save (interval $interval min), see its lock under /tmp/tmux-continuum-*"
fi

if [ -z "$(tl_option @resurrect-hook-post-save-all)" ]; then
  echo "tmux-autosave: warning: no @resurrect-hook-post-save-all in this server, so the omp/claude/codex session maps are not written and a reboot cannot relaunch them (the server was started before rig's tmux config was applied)" >&2
fi
echo "tmux-autosave: ok, last autosave $((age / 60)) min ago (every $interval min)"
