#!/usr/bin/env python3
"""Provision the home native-record scanner from pinned PM templates.

Guardian's existing exact-principal consent is the authority. This helper never
grants consent, changes a browser, or stops a running scanner service. Turning
off the option or Guardian policy disables only this module's scanner timer.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import time
import traceback

UNIT = "pm-chatgpt-native-stall"
HEADER = "# Managed by ubuntu-tweaks (profile module chatgpt-guardian); local edits are overwritten on apply.\n"
EMAIL = re.compile(r"[a-zA-Z0-9_.+\-]+@[a-zA-Z0-9.\-]+\.[a-zA-Z]{2,}")
MAX_TEXT = 65536


class Problem(Exception):
    """A sanitized diagnostic: never include raw policy or subprocess output."""


class Log:
    def __init__(self):
        directory = Path(tempfile.mkdtemp(prefix="chatgpt-guardian-native-", dir="/tmp"))
        self.path = directory / "run.log"
        self.stream = self.path.open("x", encoding="utf-8")
        self.path.chmod(0o600)
        self.started = time.monotonic()
        print(f"home native scanner log: {self.path}", file=sys.stderr)
        self.record("start")

    def record(self, stage, **fields):
        row = {
            "at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "elapsed_seconds": round(time.monotonic() - self.started, 3),
            "stage": stage,
            **fields,
        }
        self.stream.write(json.dumps(row, sort_keys=True) + "\n")
        self.stream.flush()

    def close(self, code):
        self.record("complete", returncode=code)
        self.stream.close()
        print(f"home native scanner result: {code}; log: {self.path}", file=sys.stderr)


class Scanner:
    def __init__(self, home, package, enabled, mode, log):
        self.home, self.package = home, package
        self.enabled, self.mode, self.log = enabled, mode, log
        self.units = home / ".config/systemd/user"
        self.env_file = home / ".config/pm-native-stall/home.env"
        self.guardian = home / ".local/bin/chatgpt-guardian"
        self.deployment = home / ".config/agent-tools/chatgpt-guardian/home.json"

    def call(self, label, args, *, timeout=15):
        self.log.record(label, outcome="started")
        try:
            result = subprocess.run(
                args, capture_output=True, text=True, timeout=timeout, check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.log.record(label, outcome="failed", error_type=type(exc).__name__)
            raise Problem(f"{label} could not complete") from None
        self.log.record(label, returncode=result.returncode, stderr_bytes=len(result.stderr))
        return result

    def sc(self, *args):
        result = self.call("systemctl-" + args[0], ["systemctl", "--user", *args])
        if result.returncode:
            raise Problem("systemctl " + args[0] + " failed")
        return result.stdout.strip()

    def principal(self):
        # `status` may initialize a missing store. Provisioning never creates one.
        if not self.deployment.is_file():
            raise Problem("Guardian home deployment is not initialized")
        if not self.guardian.is_file() or not os.access(self.guardian, os.X_OK):
            raise Problem("Guardian is not installed yet")
        result = self.call("read-home-policy", [str(self.guardian), "--workspace", "home", "status"])
        if result.returncode or len(result.stdout) > 2 * 1024 * 1024:
            raise Problem("Guardian home policy is unavailable")
        try:
            controls = json.loads(result.stdout)["controls"]
            if not isinstance(controls, dict):
                raise ValueError
            who = controls.get("native-stall:principal", "")
            if not isinstance(who, str):
                raise ValueError
            if not who:
                self.log.record("policy", enabled=False)
                return None
            # Guardian principal() and PM principal_name() use this same normalization.
            who = who.strip().lower()
            if len(who) > 254 or EMAIL.fullmatch(who) is None:
                raise ValueError
        except (ValueError, TypeError, KeyError):
            raise Problem("Guardian home policy is unrecognized") from None
        self.log.record("policy", enabled=True)
        return who

    @staticmethod
    def text(path):
        if path.stat().st_size > MAX_TEXT:
            raise Problem("scanner configuration exceeds its size bound")
        return path.read_text(encoding="utf-8")

    def templates(self):
        source = self.package / "pmlib/chatgpt_control/units"
        result = {}
        for kind in ("service", "timer"):
            path = source / f"{UNIT}.{kind}"
            if not path.is_file():
                raise Problem("the pinned PM source does not ship native scanner units")
            result[kind] = HEADER + self.text(path)
        return result

    def managed(self):
        path = self.units / f"{UNIT}.timer"
        return (
            path.is_file() and not path.is_symlink()
            and path.stat().st_uid == os.getuid() and self.text(path).startswith(HEADER)
        )

    def timer_state(self):
        name = f"{UNIT}.timer"
        enabled = self.call("timer-is-enabled", ["systemctl", "--user", "is-enabled", name])
        active = self.call("timer-is-active", ["systemctl", "--user", "is-active", name])
        e, a = enabled.stdout.strip(), active.stdout.strip()
        if enabled.returncode not in (0, 1, 3, 4) or e not in (
            "enabled", "enabled-runtime", "disabled", "static", "indirect", "masked",
            "masked-runtime", "not-found",
        ):
            raise Problem("the user manager could not report the scanner timer enable state")
        if active.returncode not in (0, 3, 4) or a not in ("active", "inactive", "failed", "unknown"):
            raise Problem("the user manager could not report the scanner timer activity")
        return e == "enabled", a == "active", e == "enabled-runtime"

    @staticmethod
    def validate_target(path):
        if path.is_symlink():
            raise Problem("a managed scanner destination is a symlink")
        if path.exists() and (not path.is_file() or path.stat().st_uid != os.getuid()):
            raise Problem("a managed scanner destination is not an owned regular file")

    def validate_private(self):
        self.validate_target(self.env_file)
        parent = self.env_file.parent
        if parent.is_symlink() or (
            parent.exists() and (not parent.is_dir() or parent.stat().st_uid != os.getuid())
        ):
            raise Problem("the private scanner directory is not an owned directory")

    def matches(self, path, text, mode):
        return (
            path.is_file() and not path.is_symlink()
            and path.stat().st_uid == os.getuid()
            and stat.S_IMODE(path.stat().st_mode) == mode
            and self.text(path) == text
        )

    def write(self, path, content, mode, *, private=False):
        path.parent.mkdir(parents=True, exist_ok=True)
        if private:
            path.parent.chmod(0o700)
        fd, temporary = tempfile.mkstemp(prefix="." + path.name + "-", dir=path.parent)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as output:
                os.fchmod(output.fileno(), mode)
                output.write(content)
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, path)
        finally:
            Path(temporary).unlink(missing_ok=True)
        self.log.record("write", target="private-environment" if private else path.name, mode=oct(mode))

    def disable(self):
        # Disabling never depends on release files, login state or private env contents.
        if not self.managed():
            return 0
        enabled, active, runtime_enabled = self.timer_state()
        drift = enabled or active or runtime_enabled
        if self.mode == "check":
            if drift:
                print("drift: home native scanner timer must be disabled")
                return 3
            return 0
        if drift:
            self.sc("disable", "--now", f"{UNIT}.timer")
        print("home native scanner: timer disabled; Guardian consent remains unchanged")
        return 0

    def disable_only(self):
        if not self.managed():
            return 0
        if not self.enabled:
            return self.disable()
        try:
            who = self.principal()
        except (Problem, OSError, UnicodeError):
            # The normal installer may repair this very venv or deployment next.
            # Unknown policy never enables/disables anything or prevents that repair;
            # the final post-repair pass still requires a readable current policy.
            self.log.record("early-policy-unavailable", outcome="deferred-to-final-check")
            print("home native scanner: policy check deferred until Guardian is repaired")
            return 0
        if who is None:
            return self.disable()
        try:
            self.validate_private()
            matches = self.matches(
                self.env_file, f"PM_NATIVE_STALL_PRINCIPAL={who}\n", 0o600
            ) and stat.S_IMODE(self.env_file.parent.stat().st_mode) == 0o700
        except (Problem, OSError, UnicodeError):
            matches = False
        if not matches:
            # A known principal change withdraws the old timer even if a later
            # unrelated gate fails. The final pass alone writes/re-enables it.
            self.log.record("early-environment-drift", outcome="disable-timer")
            return self.disable()
        return 0

    def run(self):
        if self.mode == "disable-only":
            return self.disable_only()
        if not self.enabled and not self.managed():
            if self.mode == "plan":
                print("home native scanner: not managed (native_stall_home is false)")
            return 0
        if self.mode == "plan":
            if self.enabled:
                print(
                    "home native scanner: install service/timer from the pinned PM source; "
                    "derive a private home.env from existing home Guardian consent; "
                    "enable the timer only while that policy is enabled"
                )
            else:
                print("home native scanner: disable the managed timer; keep its checkpoint and environment")
            return 0

        if self.enabled and self.mode == "check" and not self.deployment.is_file():
            print("drift: home native scanner needs an initialized Guardian home deployment")
            return 3
        who = self.principal() if self.enabled else None
        if who is None:
            return self.disable()
        templates = self.templates()
        # Validate every destination before the first write or systemd mutation.
        for kind in templates:
            target = self.units / f"{UNIT}.{kind}"
            self.validate_target(target)
            if target.exists() and not self.text(target).startswith(HEADER):
                raise Problem("an existing scanner unit is not managed by this module")
        self.validate_private()
        enabled, active, _ = self.timer_state()
        drift = [
            kind for kind, content in templates.items()
            if not self.matches(self.units / f"{UNIT}.{kind}", content, 0o644)
        ]
        environment = f"PM_NATIVE_STALL_PRINCIPAL={who}\n"
        env_drift = (
            not self.matches(self.env_file, environment, 0o600)
            or stat.S_IMODE(self.env_file.parent.stat().st_mode) != 0o700
        )
        timer_drift = not enabled or not active
        if self.mode == "check":
            if drift or env_drift or timer_drift:
                print("drift: home native scanner units, private environment or timer state differ")
                return 3
            return 0

        for kind in drift:
            self.write(self.units / f"{UNIT}.{kind}", templates[kind], 0o644)
        if env_drift:
            self.write(self.env_file, environment, 0o600, private=True)
        if drift:
            self.sc("daemon-reload")
        if not enabled or not active:
            self.sc("enable", "--now", f"{UNIT}.timer")
        if "timer" in drift and active:
            self.sc("restart", f"{UNIT}.timer")
        print("home native scanner: installed; timer enabled for existing Guardian consent")
        return 0


def main():
    log = Log()
    code = 1
    try:
        parser = argparse.ArgumentParser(description=__doc__)
        modes = parser.add_mutually_exclusive_group()
        modes.add_argument("--plan", action="store_const", const="plan", dest="mode")
        modes.add_argument("--check", action="store_const", const="check", dest="mode")
        modes.add_argument("--disable-only", action="store_const", const="disable-only", dest="mode")
        options = parser.add_mutually_exclusive_group(required=True)
        options.add_argument("--enabled", action="store_true", dest="enabled")
        options.add_argument("--disabled", action="store_false", dest="enabled")
        parser.add_argument("--pm-package", type=Path, required=True)
        args = parser.parse_args()
        log.record("arguments", mode=args.mode or "apply", enabled=args.enabled)
        code = Scanner(Path.home(), args.pm_package, args.enabled, args.mode or "apply", log).run()
        return code
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else 1
        raise
    except Problem as exc:
        log.record("refused", reason=str(exc))
        print("home native scanner: " + str(exc), file=sys.stderr)
        return code
    except (OSError, UnicodeError) as exc:
        log.record("failed", error_type=type(exc).__name__, frames=traceback.format_tb(exc.__traceback__))
        print("home native scanner: configuration could not be read or written", file=sys.stderr)
        return code
    finally:
        log.close(code)


if __name__ == "__main__":
    sys.exit(main())
