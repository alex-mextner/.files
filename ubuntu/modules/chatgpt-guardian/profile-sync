def load_relogin():
    """relogin is a sibling file without an extension: its stop / start / verify / probe code is imported, not copied."""
    path = Path(__file__).resolve().with_name("relogin")
    loader = importlib.machinery.SourceFileLoader("chatgpt_guardian_relogin", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


relogin = load_relogin()


class SyncError(Exception):
    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


class UsageError(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise UsageError(message)


@dataclass(frozen=True)
class Snapshot:
    columns: tuple[str, ...]
    rows: list[tuple]
    version: str

    def hosts(self) -> Counter:
        index = self.columns.index("host_key")
        return Counter(row[index] for row in self.rows)

    def prefixes(self) -> Counter:
        if "encrypted_value" not in self.columns:
            return Counter()
        index = self.columns.index("encrypted_value")
        kinds = Counter()
        for row in self.rows:
            blob = row[index]
            kinds[blob[:3].decode("ascii") if isinstance(blob, bytes) and blob[:3] in (b"v10", b"v11") else "plain"] += 1
        return kinds


def say(lang: str, key: str, **values) -> str:
    return TEXT[lang][key].format(**values)


def tell(text: str, *, error: bool = False) -> None:
    relogin.tell(text, error=error)


# -- the cookie databases ----------------------------------------------------------------------------------------------


def cookie_db(profile: Path) -> Path | None:
    for relative in COOKIE_DBS:
        candidate = profile / relative
        if candidate.is_file():
            return candidate
    return None


def table_columns(connection: sqlite3.Connection) -> tuple[str, ...]:
    return tuple(row[1] for row in connection.execute("PRAGMA table_info(cookies)"))


def meta_version(connection: sqlite3.Connection) -> str:
    try:
        row = connection.execute("SELECT value FROM meta WHERE key = 'version'").fetchone()
    except sqlite3.Error:
        return ""
    return str(row[0]) if row else ""


def copy_database(origin: sqlite3.Connection, destination: sqlite3.Connection, budget: float) -> None:
    """The sqlite3 backup API, bounded: a database another connection holds locked makes the plain call retry for ever, and
    a signal is only handled between Python statements, so the progress callback is what ends the wait."""
    deadline = time.monotonic() + budget

    def progress(_status: int, _remaining: int, _total: int) -> None:
        if time.monotonic() > deadline:
            raise sqlite3.OperationalError("timed out waiting for the database")

    origin.backup(destination, pages=256, progress=progress, sleep=0.05)


def read_snapshot(path: Path, budget: float) -> Snapshot:
    """The ChatGPT / OpenAI rows of a database that no process has open: read through the backup API into memory, so the
    whole file (every other cookie of the profile) is never copied to disk and the original is opened read-only."""
    origin = sqlite3.connect(f"{path.absolute().as_uri()}?mode=ro", uri=True, timeout=budget)
    memory = sqlite3.connect(":memory:")
    try:
        copy_database(origin, memory, budget)
        columns = table_columns(memory)
        if not columns:
            raise sqlite3.DatabaseError("no cookies table")
        quoted = ", ".join(f'"{c}"' for c in columns)
        rows = memory.execute(f"SELECT {quoted} FROM cookies WHERE {HOST_FILTER} ORDER BY host_key, name, path").fetchall()
        return Snapshot(columns, rows, meta_version(memory))
    finally:
        memory.close()
        origin.close()


def private_file(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))


def back_up(target: Path, destination: Path, budget: float) -> None:
    private_file(destination)
    origin = sqlite3.connect(target, timeout=budget)
    copy = sqlite3.connect(destination)
    try:
        copy_database(origin, copy, budget)
    except BaseException:
        destination.unlink(missing_ok=True)  # a partial backup must not look like a good one
        raise
    finally:
        copy.close()
        origin.close()


def restore(backup: Path, target: Path, budget: float) -> None:
    """Back through the backup API into the database file Chrome owns (stopped): transactional, no raw file replace."""
    origin = sqlite3.connect(f"{backup.absolute().as_uri()}?mode=ro", uri=True, timeout=budget)
    destination = sqlite3.connect(target, timeout=budget)
    try:
        copy_database(origin, destination, budget)
        check = destination.execute("PRAGMA integrity_check").fetchone()
        if not check or check[0] != "ok":
            raise sqlite3.DatabaseError("integrity check failed after the restore")
    finally:
        destination.close()
        origin.close()


def apply_rows(target: Path, snapshot: Snapshot, lang: str, budget: float) -> int:
    """Replace the target's ChatGPT / OpenAI rows with the snapshot in one transaction; returns how many rows were replaced."""
    connection = sqlite3.connect(target, timeout=budget, isolation_level=None)
    try:
        columns = table_columns(connection)
        if set(columns) != set(snapshot.columns):
            raise SyncError(say(lang, "schema_differs", what="columns"))
        version = meta_version(connection)
        if version != snapshot.version:
            raise SyncError(say(lang, "schema_differs", what=f"meta version {snapshot.version or '-'} / {version or '-'}"))
        placeholders = ", ".join("?" for _ in snapshot.columns)
        names = ", ".join(f'"{c}"' for c in snapshot.columns)
        connection.execute("BEGIN IMMEDIATE")
        try:
            replaced = connection.execute(f"DELETE FROM cookies WHERE {HOST_FILTER}").rowcount
            connection.executemany(f"INSERT INTO cookies ({names}) VALUES ({placeholders})", snapshot.rows)
            connection.execute("COMMIT")
        except BaseException:
            connection.execute("ROLLBACK")
            raise
        check = connection.execute("PRAGMA integrity_check").fetchone()
        if not check or check[0] != "ok":
            raise SyncError(say(lang, "integrity", why=str(check[0] if check else "no answer")[:200]))
        return replaced
    finally:
        connection.close()


def prune_backups(directory: Path) -> None:
    for old in sorted(directory.glob("Cookies-*"))[:-KEEP_BACKUPS]:
        old.unlink(missing_ok=True)


