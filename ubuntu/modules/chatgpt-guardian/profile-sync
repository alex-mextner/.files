@dataclass(frozen=True)
class Context:
    env: dict
    lang: str
    home: Path
    options: dict
    db_budget: float


def describe(error: BaseException) -> str:
    """What to print about a failure. A sqlite3 message can quote the row it choked on (a cookie value), so only its class
    and SQLite's error name are ever shown."""
    if isinstance(error, sqlite3.Error):
        return f"{type(error).__name__} {getattr(error, 'sqlite_errorname', '')}".strip()
    if isinstance(error, OSError):
        return error.strerror or type(error).__name__
    return str(error)


def make_context(env: dict) -> Context:
    lang = env.get("UBUNTU_TWEAK_LANG", "en")
    lang = lang if lang in TEXT else "en"
    try:
        options = json.loads(env.get("UBUNTU_TWEAK_MODULE_CONFIG") or "{}")
    except json.JSONDecodeError as error:
        raise relogin.ConfigError(f"UBUNTU_TWEAK_MODULE_CONFIG is not JSON: {error}") from None
    if not isinstance(options, dict):
        raise relogin.ConfigError("UBUNTU_TWEAK_MODULE_CONFIG must be a JSON object")
    raw = env.get("CHATGPT_PROFILE_SYNC_DB_TIMEOUT", "")
    try:
        budget = float(raw) if raw else DB_BUDGET
    except ValueError:
        raise relogin.ConfigError(f"CHATGPT_PROFILE_SYNC_DB_TIMEOUT must be a number: {raw}") from None
    if budget <= 0:
        raise relogin.ConfigError(f"CHATGPT_PROFILE_SYNC_DB_TIMEOUT must be positive: {raw}")
    return Context(env, lang, Path(env.get("HOME") or Path.home()), options, budget)


def workspace_settings(ctx: Context, workspace: Workspace):
    """relogin's own Settings, aimed at one workspace: its units, profile and DevTools port; the rest is relogin's."""
    port = ctx.env.get("CHATGPT_PROFILE_SYNC_PORT") or str(ctx.options.get(workspace.port_option, workspace.default_port))
    profile = ctx.env.get("CHATGPT_PROFILE_SYNC_TARGET") or str(ctx.home / ".local/share/agent-tools" / GUARDIAN_PROFILES / workspace.profile)
    scoped = {
        **ctx.env,
        "CHATGPT_RELOGIN_PROFILE": profile,
        "CHATGPT_RELOGIN_GUARDIAN_UNIT": workspace.unit,
        "CHATGPT_RELOGIN_OBSERVER_UNIT": f"{workspace.unit}-observer",
        "CHATGPT_RELOGIN_BROWSER_UNIT": f"{workspace.unit}-browser",
        "CHATGPT_RELOGIN_DEVTOOLS_PORT": port,
    }
    return relogin.load_settings(scoped)


def source_dir(ctx: Context, given: str | None) -> Path:
    chosen = given or ctx.env.get("CHATGPT_PROFILE_SYNC_SOURCE")
    return (Path(chosen).expanduser() if chosen else ctx.home / ".config/google-chrome").absolute()


def backup_dir(ctx: Context, workspace: Workspace) -> Path:
    base = ctx.env.get("CHATGPT_PROFILE_SYNC_BACKUPS")
    return (Path(base).expanduser() if base else ctx.home / ".local/state/ubuntu-tweaks/chatgpt-guardian-profile-sync") / workspace.name


def join(units) -> str:
    return ", ".join(units)


def stack_units(settings) -> tuple[list[str], list[str]]:
    return [settings.guardian, settings.observer, settings.browser], [settings.browser, settings.observer, settings.guardian]


def open_pids(profile: Path) -> list[int]:
    return relogin.profile_in_use(profile)


def pid_text(pids: list[int]) -> str:
    return " ".join(str(p) for p in pids if p > 0) or "?"


# -- pull --------------------------------------------------------------------------------------------------------------


def devtools_request(port: int, path: str, method: str = "GET") -> dict | None:
    """One loopback DevTools HTTP request; the parsed JSON object it answers with, else None. Never raises."""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(urllib.request.Request(f"http://127.0.0.1:{port}{path}", method=method), timeout=10) as answer:
            body = json.loads(answer.read() or b"{}")
    except (OSError, ValueError):  # URLError is an OSError, JSONDecodeError a ValueError
        return None
    return body if isinstance(body, dict) else None


def ask_account(settings):
    """relogin's await_account; when the restarted browser shows no ChatGPT tab (a profile whose tabs were closed restores to
    chrome://newtab/ only), open one for the question and leave it open: the glide guardian's start check
    (`relogin check --live`) and the guardian itself need a ChatGPT tab as well."""
    answer = relogin.await_account(settings)
    if answer.kind != "unavailable" or answer.reason != "why_tab":
        return answer
    opened = devtools_request(settings.port, f"/json/new?{CHATGPT_URL}", "PUT")
    if opened is None or not isinstance(opened.get("id"), str):
        return answer
    return relogin.await_account(settings)


def judge(settings, workspace: Workspace, expected: str | None, lang: str):
    """(answer, confirmed, reason) for the browser's answer after the copy: the semantics of `relogin check --live`, the
    browser's answer only. glide: the domain of glide_email_domain (`expected` is that or None); home: `expected`, else
    any visible domain but the glide account's."""
    answer = ask_account(settings)
    if answer.kind == "unavailable":
        return answer, False, say(lang, "unreadable", reason=settings.say(answer.reason, port=settings.port))
    if answer.kind == "signed-out":
        return answer, False, say(lang, "signed_out")
    if not answer.domain:
        return answer, False, say(lang, "domain_unknown")
    want = expected or (settings.domain if workspace.name == "glide" else None)
    if want is not None:
        if answer.domain == want:
            return answer, True, ""
        return answer, False, say(lang, "wrong_domain", domain=answer.domain, want=want)
    if answer.domain == settings.domain:
        return answer, False, say(lang, "is_glide_domain", domain=answer.domain)
    return answer, True, ""


def now_text() -> str:
    """The journal cutoff, as relogin takes it: the current whole second (journalctl --since has no finer resolution). Rounding up
    would risk the opposite error: the guardian reports an unchanged health state only every 300 s, so a first line that falls
    before the cutoff would never be seen and a good pull would be rolled back. A stale line of the old guardian in the same
    second can at worst let the health check pass early; the account answer of the browser is the actual verdict."""
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(int(time.time())))


def reset_start_limits(settings) -> None:
    """The browser units allow two starts per five minutes: a start for the verification plus one of the rollback (or an
    earlier restart) would be refused. reset-failed clears that counter; a failure to do so changes nothing else."""
    for unit in (settings.browser, settings.observer, settings.guardian):
        try:
            relogin.systemctl(settings, "reset-failed", unit, timeout=30)
        except subprocess.TimeoutExpired:
            continue


def recover(ctx: Context, settings, workspace: Workspace, backup: Path | None, modified: bool) -> str:
    """Whatever went wrong after the first stop: put the old cookies back when the target was changed, then start the three
    units again. When the restore fails the units stay stopped (the unconfirmed cookies are still in place and a guardian
    that meets them could latch a human-challenge stop); returns "" or why the restore failed."""
    failure = ""
    try:
        if modified and backup is not None:
            # every unit is tried: a browser that is still running holds the database, and the others must not be left behind it
            stuck = [line for line in (relogin.stop_unit(settings, unit) for unit in stack_units(settings)[0]) if line]
            if stuck:
                raise relogin.RunError("; ".join(stuck))
            busy = relogin.wait_profile_free(settings, settings.stop_timeout)
            if busy:
                raise SyncError(say(ctx.lang, "target_open", seconds=settings.stop_timeout, pids=pid_text(busy)), 3)
            db = cookie_db(settings.profile)
            if db is None:
                raise SyncError(say(ctx.lang, "no_target", path=settings.profile), 2)
            tell(say(ctx.lang, "restoring", path=backup))
            restore(backup, db, ctx.db_budget)
            tell(say(ctx.lang, "restored", workspace=workspace.name))
    except (SyncError, relogin.RunError, sqlite3.Error, OSError) as error:
        failure = describe(error)
    if failure:
        return failure
    since = now_text()
    tell(say(ctx.lang, "starting", units=join(stack_units(settings)[1])))
    reset_start_limits(settings)
    for line in relogin.start_units(settings):
        tell(line, error=True)
    relogin.wait_stack(settings, since, [])
    return ""


def cmd_pull(ctx: Context, args) -> int:
    workspace = WORKSPACES[args.workspace]
    settings = workspace_settings(ctx, workspace)
    lang = ctx.lang
    expected = None
    if args.expect_domain:
        if not re.fullmatch(relogin.DOMAIN_PATTERN, args.expect_domain):
            tell(say(lang, "bad_domain", domain=args.expect_domain), error=True)
            return 2
        expected = args.expect_domain.lstrip("@").lower()
        if workspace.name == "glide" and expected != settings.domain:
            # the glide guardian unit only starts for glide_email_domain (relogin check --live is its ExecStartPre)
            tell(say(lang, "glide_domain_fixed", domain=settings.domain), error=True)
            return 2
    source = source_dir(ctx, args.source)
    target = settings.profile
    try:
        if source.exists() and target.exists() and source.samefile(target):
            raise SyncError(say(lang, "same_profile", path=source), 2)
        source_db = cookie_db(source)
        if source_db is None:
            raise SyncError(say(lang, "no_source", path=source), 2)
        if cookie_db(target) is None:
            raise SyncError(say(lang, "no_target", path=target), 2)
        pids = open_pids(source)
        if pids:
            raise SyncError(say(lang, "source_open", path=source, pids=pid_text(pids)), 3)
        try:
            snapshot = read_snapshot(source_db, ctx.db_budget)
        except (sqlite3.Error, OSError) as error:
            raise SyncError(say(lang, "source_unreadable", why=describe(error)), 1) from None
        if not snapshot.rows:
            raise SyncError(say(lang, "no_rows"), 1)
    except SyncError as error:
        tell(str(error), error=True)
        return error.code

    units, back = stack_units(settings)
    destination = backup_dir(ctx, workspace)
    rule = say(lang, "rule_domain", domain=expected or settings.domain) if expected or workspace.name == "glide" else say(lang, "rule_home", domain=settings.domain)
    hosts = ", ".join(f"{host} {count}" for host, count in sorted(snapshot.hosts().items()))
    kinds = ", ".join(f"{kind} {count}" for kind, count in sorted(snapshot.prefixes().items())) or "-"
    tell(say(lang, "plan_source", path=source_db, count=len(snapshot.rows), hosts=hosts, kinds=kinds))
    tell(say(lang, "plan_target", path=target, workspace=workspace.name))
    tell(say(lang, "plan_steps", units=join(units), backup_dir=destination, first=settings.browser, rest=join(back[1:]), rule=rule))
    if args.dry_run:
        tell(say(lang, "dry_run"))
        return 0
    try:
        with relogin.profile_lock(settings):  # shared with `relogin run`: neither may open or rewrite the profile meanwhile
            return run_pull(ctx, settings, workspace, expected, source, snapshot, destination)
    except relogin.RunError as error:  # the lock only: run_pull handles the errors of its own steps
        tell(str(error), error=True)
        return 3


def run_pull(ctx: Context, settings, workspace: Workspace, expected: str | None, source: Path, snapshot: Snapshot, destination: Path) -> int:
    lang = ctx.lang
    target = settings.profile
    units, _ = stack_units(settings)
    backup: Path | None = None
    modified = False
    confirmed = False
    failure = ""
    code = 1
    restore_failure = ""
    domain = ""
    with relogin.interrupts_as_exception() as guard:
        try:
            tell(say(lang, "stopping", workspace=workspace.name, units=join(units)))
            relogin.stop_units(settings)
            busy = relogin.wait_profile_free(settings, settings.stop_timeout)
            if busy:
                raise SyncError(say(lang, "target_open", seconds=settings.stop_timeout, pids=pid_text(busy)), 3)
            pids = open_pids(source)  # the source may have been opened while the units were stopping
            if pids:
                raise SyncError(say(lang, "source_open", path=source, pids=pid_text(pids)), 3)
            target_db = cookie_db(target)
            if target_db is None:
                raise SyncError(say(lang, "no_target", path=target), 2)
            backup = destination / f"Cookies-{time.strftime('%Y%m%dT%H%M%S')}"
            tell(say(lang, "backing_up", path=backup))
            back_up(target_db, backup, ctx.db_budget)
            modified = True
            replaced = apply_rows(target_db, snapshot, lang, ctx.db_budget)
            tell(say(lang, "copied", replaced=replaced, count=len(snapshot.rows)))
            # Browser alone first: a guardian that meets rejected cookies (a 401) latches a human-challenge stop that a restore
            # does not clear, so the observer and the guardian start only once the browser shows the right account.
            tell(say(lang, "starting_browser", unit=settings.browser))
            reset_start_limits(settings)
            started = relogin.start_unit(settings, settings.browser)
            if started:
                tell(started, error=True)
            answer, accepted, why = judge(settings, workspace, expected, lang)
            if not accepted:
                failure, code = say(lang, "not_confirmed", what=why), 4
            else:
                domain = answer.domain
                since = now_text()  # after the verification: the old guardian stopped before the copy, so its last line is older
                tell(say(lang, "starting", units=join([settings.observer, settings.guardian])))
                failures = [line for line in (relogin.start_unit(settings, settings.observer), relogin.start_unit(settings, settings.guardian)) if line]
                if relogin.wait_stack(settings, since, failures):
                    confirmed = True
                else:
                    failure, code = say(lang, "not_confirmed", what=say(lang, "stack_down")), 4
        except relogin.Interrupted:
            failure, code = say(lang, "interrupted"), 130
        except SyncError as error:
            failure, code = str(error), error.code
        except relogin.RunError as error:
            failure = str(error)
        except (sqlite3.Error, OSError) as error:
            failure = say(lang, "copy_failed", why=describe(error))
        finally:
            # From the first stop on, nothing ends before the units are back: signals no longer interrupt this.
            guard.armed = False
            if failure:
                tell(failure, error=True)
            if not confirmed:
                restore_failure = recover(ctx, settings, workspace, backup, modified)
    if restore_failure:
        tell(say(lang, "restore_failed", why=restore_failure, path=backup, workspace=workspace.name), error=True)
        return 5
    prune_backups(destination)
    if not confirmed:
        return code
    if workspace.name == "glide" and domain == settings.domain:
        relogin.write_marker(settings, settings.domain)
    tell(say(lang, "confirmed", workspace=workspace.name, domain=domain))
    return 0


# -- status ------------------------------------------------------------------------------------------------------------


def cmd_status(ctx: Context) -> int:
    lang = ctx.lang
    tell(say(lang, "status_header"))
    for workspace in WORKSPACES.values():
        settings = workspace_settings(ctx, workspace)
        answer = relogin.probe(settings.port, settings.probe_timeout)
        if answer.kind == "account" and answer.domain:
            tell(say(lang, "status_account", workspace=workspace.name, domain=answer.domain))
        elif answer.kind == "account":
            tell(say(lang, "status_unknown_domain", workspace=workspace.name))
        elif answer.kind == "signed-out":
            tell(say(lang, "status_signed_out", workspace=workspace.name))
        else:
            tell(say(lang, "status_unreachable", workspace=workspace.name, reason=settings.say(answer.reason, port=settings.port)))
    source = source_dir(ctx, None)
    db = cookie_db(source)
    if db is None:
        tell(say(lang, "status_source_missing", path=source))
        return 0
    if open_pids(source):
        tell(say(lang, "status_source_open", path=source))
        return 0
    try:
        count = len(read_snapshot(db, ctx.db_budget).rows)
    except (sqlite3.Error, OSError) as error:
        tell(say(lang, "status_source_unreadable", path=source, why=describe(error)))
        return 0
    tell(say(lang, "status_source", path=source, count=count))
    return 0


def parse(argv: list[str]):
    parser = Parser(prog="profile-sync", add_help=False)
    commands = parser.add_subparsers(dest="command", required=True, parser_class=Parser)
    pull = commands.add_parser("pull", add_help=False)
    pull.add_argument("workspace", choices=sorted(WORKSPACES))
    pull.add_argument("--from", dest="source")
    pull.add_argument("--expect-domain")
    pull.add_argument("--dry-run", action="store_true")
    commands.add_parser("status", add_help=False)
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    lang = os.environ.get("UBUNTU_TWEAK_LANG", "en")
    lang = lang if lang in TEXT else "en"
    if argv in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    try:
        args = parse(argv)
    except UsageError as error:
        print(f"profile-sync: {error}", file=sys.stderr)
        print(TEXT[lang]["usage"], file=sys.stderr)
        return 2
    try:
        ctx = make_context(dict(os.environ))
        code = cmd_pull(ctx, args) if args.command == "pull" else cmd_status(ctx)
    except relogin.ConfigError as error:
        print(f"profile-sync: {error}", file=sys.stderr)
        return 2
    for stream in (sys.stdout, sys.stderr):  # a hung-up terminal must not turn the exit code into 120 at shutdown
        try:
            stream.flush()
        except OSError:
            os.dup2(os.open(os.devnull, os.O_WRONLY), stream.fileno())
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
