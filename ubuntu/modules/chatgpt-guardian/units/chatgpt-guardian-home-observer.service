[Unit]
Description=Read-only ChatGPT Guardian session evidence (main account home)
After=chatgpt-guardian-home-browser.service graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/agent-tools/chatgpt-guardian/home.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=%h/.cache/chatgpt-guardian-monitor
# Playwright makes its temp dirs under TMPDIR; systemd creates the folder (a fresh machine has no ~/.cache/<it>), else connect_over_cdp fails with ENOENT.
CacheDirectory=chatgpt-guardian-monitor
CacheDirectoryMode=0700
ExecStart=%h/.local/share/agent-tools/chatgpt-guardian-venv/bin/chatgpt-guardian --workspace home observer --cdp http://127.0.0.1:@HOME_PORT@ --interval 60
# 120 s x Burst 3 >= the 300 s interval: a persistent failure restarts at 0/120/240 s and never trips the start limit for good.
Restart=on-failure
RestartSec=120
Nice=10
CPUQuota=15%
MemoryHigh=192M
MemoryMax=384M
ManagedOOMPreference=avoid
TasksMax=32
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
