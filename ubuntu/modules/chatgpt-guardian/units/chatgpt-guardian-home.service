[Unit]
Description=ChatGPT Guardian for main account home - bounded confirmed continuation
Requires=chatgpt-guardian-home-browser.service
After=chatgpt-guardian-home-browser.service graphical-session.target
BindsTo=chatgpt-guardian-home-browser.service
PartOf=graphical-session.target
ConditionPathExists=%h/.config/agent-tools/chatgpt-guardian/home.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h
# The module (profile module chatgpt-guardian) enables and starts this unit only once the profile is signed in.
# This is a visible desktop, so --private-display is deliberately absent: the guardian never raises a tab, and Chrome
# throttles the frames of a background tab, so only the foreground tab of this window can be model-probed and acted on.
ExecStart=%h/.local/share/agent-tools/chatgpt-guardian-venv/bin/chatgpt-guardian --workspace home live --cdp http://127.0.0.1:@HOME_PORT@ --poll-interval 60 --max-pages 6 --min-available-mib 2048 --control-port 8790 --apply
Restart=on-failure
RestartSec=60
CPUQuota=25%
MemoryHigh=256M
MemoryMax=768M
TasksMax=64
TimeoutStopSec=45
SendSIGKILL=no
LogRateLimitIntervalSec=60s
LogRateLimitBurst=30

[Install]
WantedBy=graphical-session.target
