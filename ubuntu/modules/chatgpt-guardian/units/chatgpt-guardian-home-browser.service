[Unit]
Description=ChatGPT Guardian main-account browser (dedicated home profile)
After=graphical-session.target
@HOME_DISPLAY_UNIT@
PartOf=graphical-session.target
ConditionPathExists=%h/.config/agent-tools/chatgpt-guardian/home.json
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h
UnsetEnvironment=WAYLAND_DISPLAY
@HOME_DISPLAY_SERVICE@
ExecStart=@CHROME@ --user-data-dir=%h/.local/share/agent-tools/chatgpt-guardian/profiles/home --remote-debugging-address=127.0.0.1 --remote-debugging-port=@HOME_PORT@ --ozone-platform=x11 --no-first-run --restore-last-session --start-maximized --window-size=1280,1000
Restart=on-failure
RestartSec=60
CPUQuota=200%
MemoryHigh=@HOME_MEMORY_HIGH@
MemoryMax=@HOME_MEMORY_MAX@
ManagedOOMPreference=avoid
TasksMax=1024
TimeoutStopSec=45
SendSIGKILL=no

[Install]
WantedBy=graphical-session.target
