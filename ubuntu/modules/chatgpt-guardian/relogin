    def say(self, key: str, **values) -> str:
        return TEXT[self.lang][key].format(**values)


def _number(env: dict, name: str, default: float) -> float:
    raw = env.get(name, "")
    if not raw:
        return default
    try:
        value = float(raw)
    except ValueError:
        raise ConfigError(f"{name} must be a number: {raw}") from None
    if value <= 0:
        raise ConfigError(f"{name} must be positive: {raw}")
    return value


def load_settings(env: dict) -> Settings:
    lang = env.get("UBUNTU_TWEAK_LANG", "en")
    lang = lang if lang in TEXT else "en"
    try:
        options = json.loads(env.get("UBUNTU_TWEAK_MODULE_CONFIG") or "{}")
    except json.JSONDecodeError as error:
        raise ConfigError(f"UBUNTU_TWEAK_MODULE_CONFIG is not JSON: {error}") from None
    if not isinstance(options, dict):
        raise ConfigError("UBUNTU_TWEAK_MODULE_CONFIG must be a JSON object")
    domain = options.get("glide_email_domain", DEFAULT_DOMAIN)
    if not isinstance(domain, str) or not re.fullmatch(DOMAIN_PATTERN, domain):
        raise ConfigError(TEXT[lang]["bad_option"].format(name="glide_email_domain", why="must be a domain name such as glide.vc"))
    if env.get("CHATGPT_RELOGIN_DOMAIN"):
        domain = env["CHATGPT_RELOGIN_DOMAIN"]
        if not re.fullmatch(DOMAIN_PATTERN, domain):
            raise ConfigError(f"CHATGPT_RELOGIN_DOMAIN must be a domain name such as glide.vc: {domain}")
    port_text = env.get("CHATGPT_RELOGIN_DEVTOOLS_PORT") or str(options.get("glide_port", DEFAULT_PORT))
    if not re.fullmatch(r"[0-9]+", port_text) or not 0 < int(port_text) <= 65535:
        raise ConfigError(TEXT[lang]["bad_option"].format(name="glide_port", why=f"not a port: {port_text}"))
    home = Path(env.get("HOME") or Path.home())
    chrome_option = options.get("chrome", "/usr/bin/google-chrome")
    if not isinstance(chrome_option, str) or not chrome_option:
        raise ConfigError(TEXT[lang]["bad_option"].format(name="chrome", why='must be an absolute path or "user"'))
    # The same Chrome the browser unit runs (install.sh): "user" is the rootless copy behind the dedicated wrapper.
    if chrome_option == "user":
        chrome_default = str(home / ".local/bin/chatgpt-guardian-chrome")
    else:
        chrome_default = str(home / chrome_option[2:]) if chrome_option.startswith("~/") else chrome_option
    profile = env.get("CHATGPT_RELOGIN_PROFILE") or str(home / ".local/share/agent-tools/chatgpt-guardian/profiles/glide.vc")
    return Settings(
        profile=Path(profile),
        chrome=env.get("CHATGPT_RELOGIN_CHROME") or chrome_default,
        chrome_args=shlex.split(env.get("CHATGPT_RELOGIN_CHROME_ARGS", "")),
        url=env.get("CHATGPT_RELOGIN_URL") or "https://chatgpt.com/auth/login",
        systemctl=shlex.split(env.get("CHATGPT_RELOGIN_SYSTEMCTL") or "systemctl --user"),
        journalctl=shlex.split(env.get("CHATGPT_RELOGIN_JOURNALCTL") or "journalctl --user"),
        guardian=env.get("CHATGPT_RELOGIN_GUARDIAN_UNIT") or "chatgpt-guardian-glide",
        observer=env.get("CHATGPT_RELOGIN_OBSERVER_UNIT") or "chatgpt-guardian-glide-observer",
        browser=env.get("CHATGPT_RELOGIN_BROWSER_UNIT") or "chatgpt-guardian-glide-browser",
        port=int(port_text),
        marker=Path(env.get("CHATGPT_RELOGIN_MARKER") or home / ".local/state/ubuntu-tweaks/chatgpt-guardian-glide-login"),
        domain=domain.lstrip("@").lower(),
        stop_timeout=_number(env, "CHATGPT_RELOGIN_STOP_TIMEOUT", 120.0),
        verify_timeout=_number(env, "CHATGPT_RELOGIN_VERIFY_TIMEOUT", 180.0),
        account_timeout=_number(env, "CHATGPT_RELOGIN_ACCOUNT_TIMEOUT", 30.0),
        probe_timeout=_number(env, "CHATGPT_RELOGIN_PROBE_TIMEOUT", 40.0),
        poll=_number(env, "CHATGPT_RELOGIN_POLL", 1.0),
        lock_dir=Path(env.get("CHATGPT_RELOGIN_LOCK_DIR") or home / ".local/state/ubuntu-tweaks/chatgpt-guardian-locks"),
        lang=lang,
        dry_run=env.get("UBUNTU_TWEAK_FINISH_DRY_RUN") == "1",
    )


# -- the browser's answer: DevTools over a loopback WebSocket, standard library only -------------------------------------


class Probe(NamedTuple):
    kind: str  # "account" (domain may be empty), "signed-out" or "unavailable"
    domain: str = ""
    reason: str = ""  # for "unavailable": a TEXT key


class WebSocket:
    """The least of RFC 6455 that Chrome's DevTools needs: one masked text frame out, text frames in."""

    def __init__(self, host: str, port: int, path: str, timeout: float):
        self.sock = socket.create_connection((host, port), timeout=timeout)
        self.sock.settimeout(timeout)
        key = base64.b64encode(secrets.token_bytes(16)).decode()
        self.sock.sendall(
            f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n".encode()
        )
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("closed during the handshake")
            head += chunk
            if len(head) > 65536:
                raise ConnectionError("handshake answer too long")
        text = head.split(b"\r\n\r\n", 1)[0].decode("latin-1")
        accept = base64.b64encode(hashlib.sha1((key + WEBSOCKET_GUID).encode()).digest()).decode()
        if " 101 " not in text.split("\r\n", 1)[0] or accept not in text:
            raise ConnectionError("not a WebSocket answer")
        self.buffer = head.split(b"\r\n\r\n", 1)[1]

    def close(self) -> None:
        self.sock.close()

    def _exact(self, count: int) -> bytes:
        while len(self.buffer) < count:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("connection closed")
            self.buffer += chunk
        data, self.buffer = self.buffer[:count], self.buffer[count:]
        return data

    def send(self, text: str) -> None:
        payload = text.encode()
        mask = secrets.token_bytes(4)
        size = len(payload)
        if size < 126:
            header = bytes([0x81, 0x80 | size])
        elif size < 65536:
            header = bytes([0x81, 0x80 | 126]) + struct.pack(">H", size)
        else:
            header = bytes([0x81, 0x80 | 127]) + struct.pack(">Q", size)
        self.sock.sendall(header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def receive(self) -> str:
        message = b""
        while True:
            first, second = self._exact(2)
            size = second & 0x7F
            if size == 126:
                size = struct.unpack(">H", self._exact(2))[0]
            elif size == 127:
                size = struct.unpack(">Q", self._exact(8))[0]
            if size > MAX_FRAME_BYTES or len(message) + size > MAX_FRAME_BYTES:
                raise ConnectionError("message too large")
            mask = self._exact(4) if second & 0x80 else b""
            payload = self._exact(size)
            if mask:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            opcode = first & 0x0F
            if opcode == 0x8:
                raise ConnectionError("closed by the browser")
            if opcode in (0x9, 0xA):  # ping / pong: DevTools sends none for this exchange
                continue
            message += payload
            if first & 0x80:
                return message.decode()


def _is_chatgpt(url: str) -> bool:
    """The real origin only: a look-alike such as https://chatgpt.com.example/ would run the page script for a stranger."""
    try:
        parsed = urlparse(url)
        return parsed.scheme == "https" and parsed.hostname == "chatgpt.com" and parsed.port in (None, 443)
    except ValueError:
        return False


def _devtools_pages(port: int) -> list[dict]:
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(f"http://127.0.0.1:{port}/json/list", timeout=5) as answer:
        tabs = json.load(answer)
    if not isinstance(tabs, list):
        return []
    return [t for t in tabs if isinstance(t, dict) and t.get("type") == "page" and _is_chatgpt(str(t.get("url", ""))) and t.get("webSocketDebuggerUrl")]


def _evaluate(ws_url: str, timeout: float) -> dict | None:
    parsed = urlparse(ws_url)
    if parsed.hostname not in ("127.0.0.1", "localhost"):
        return None
    ws = WebSocket("127.0.0.1", parsed.port or 80, parsed.path, timeout)
    try:
        ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {"expression": PAGE_SCRIPT, "awaitPromise": True, "returnByValue": True}}))
        while True:
            reply = json.loads(ws.receive())
            if not isinstance(reply, dict):
                return None
            if reply.get("id") == 1:
                break
    finally:
        ws.close()
    result = reply.get("result")
    inner = result.get("result") if isinstance(result, dict) else None
    value = inner.get("value") if isinstance(inner, dict) else None
    return value if isinstance(value, dict) else None


def probe(port: int, budget: float) -> Probe:
    """Ask the running browser who is signed in, within `budget` seconds in all. Never raises: every failure is an
    'unavailable' with a reason."""
    deadline = time.monotonic() + budget
    try:
        pages = _devtools_pages(port)
    except (OSError, urllib.error.URLError, ValueError):  # JSONDecodeError is a ValueError
        return Probe("unavailable", reason="why_port")
    if not pages:
        return Probe("unavailable", reason="why_tab")
    for page in pages[:3]:
        left = deadline - time.monotonic()
        if left <= 0.1:
            break
        try:
            value = _evaluate(page["webSocketDebuggerUrl"], min(left, 20.0))
        except (OSError, ConnectionError, ValueError):
            continue
        if not value:
            continue
        if value.get("state") == "user":
            return Probe("account", domain=str(value.get("domain", "")).lower())
        if value.get("state") == "none":
            return Probe("signed-out")
    return Probe("unavailable", reason="why_unreadable")


def tell(text: str, *, error: bool = False) -> None:
    """print that survives a closed terminal or pipe: a window that went away must not stop the units coming back."""
    try:
        print(text, file=sys.stderr if error else sys.stdout, flush=True)
    except OSError:
        pass


# -- the marker ---------------------------------------------------------------------------------------------------------


def marker_time(settings: Settings) -> str | None:
    try:
        text = settings.marker.read_text(encoding="utf-8").split()
    except OSError:
        return None
    return text[0] if text else None


def write_marker(settings: Settings, what: str) -> None:
    settings.marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    tmp = settings.marker.with_name(settings.marker.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(f"{stamp} {what}\n")
    os.replace(tmp, settings.marker)


# -- check --------------------------------------------------------------------------------------------------------------


def describe_account(settings: Settings, answer: Probe) -> str:
    if answer.kind == "signed-out":
        return settings.say("signed_out", want=settings.domain)
    if not answer.domain:
        return settings.say("wrong_account_unknown", want=settings.domain)
    return settings.say("wrong_account", domain=answer.domain, want=settings.domain)


def cmd_check(settings: Settings) -> int:
    answer = probe(settings.port, settings.probe_timeout)
    if answer.kind == "account" and answer.domain == settings.domain:
        tell(settings.say("ok_account", domain=answer.domain))
        return 0
    if answer.kind != "unavailable":
        tell(describe_account(settings, answer))
        return 1
    asked = settings.say("no_answer", reason=settings.say(answer.reason, port=settings.port))
    when = marker_time(settings)
    if when:
        tell(settings.say("marker_yes", asked=asked, when=when))
        return 0
    tell(settings.say("marker_no", asked=asked))
    return 1


def cmd_check_live(settings: Settings) -> int:
    """Only the browser's answer counts, never the marker: 'unavailable' is retried, then it is a failure."""
    deadline = time.monotonic() + settings.account_timeout
    while True:
        answer = probe(settings.port, max(1.0, min(settings.probe_timeout, deadline - time.monotonic())))
        if answer.kind != "unavailable" or time.monotonic() >= deadline:
            break
        time.sleep(settings.poll)
    if answer.kind == "account" and answer.domain == settings.domain:
        tell(settings.say("ok_account", domain=answer.domain))
        return 0
    if answer.kind != "unavailable":
        tell(describe_account(settings, answer))
        return 1
    asked = settings.say("no_answer", reason=settings.say(answer.reason, port=settings.port))
    tell(settings.say("live_unavailable", asked=asked))
    return 1


def open_chatgpt_tab(port: int) -> bool:
    """Open one https://chatgpt.com/ tab through DevTools (PUT /json/new) and leave it open; whether the browser took it. Never raises."""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(urllib.request.Request(f"http://127.0.0.1:{port}/json/new?https://chatgpt.com/", method="PUT"), timeout=10) as answer:
            return isinstance(json.loads(answer.read() or b"{}"), dict)
    except (OSError, ValueError):  # URLError is an OSError, JSONDecodeError a ValueError
        return False


def cmd_check_refuse_other(settings: Settings) -> int:
    """Exit 1 only for a signed-in account of another email domain; every other answer, a silent browser included, passes.

    A restarted browser shows no chatgpt.com tab (a profile whose tabs were closed restores to chrome://newtab/ only) and nothing
    opens one for home, so an answerable browser without such a tab gets one for the question and keeps it (profile-sync and revive
    do the same): otherwise the check would be blind exactly after a restart. Opening one costs one probe, not a second wait."""
    answer = probe(settings.port, settings.probe_timeout)
    if answer.kind == "unavailable" and answer.reason == "why_tab":
        open_chatgpt_tab(settings.port)
    if answer.kind == "unavailable":
        answer = await_account(settings)
    if answer.kind == "account" and answer.domain and answer.domain != settings.domain:
        tell(describe_account(settings, answer))
        return 1
    if answer.kind == "account" and answer.domain:
        tell(settings.say("ok_domain", domain=answer.domain))
        return 0
    if answer.kind == "unavailable":
        asked = settings.say("no_answer", reason=settings.say(answer.reason, port=settings.port))
    else:
        asked = describe_account(settings, answer)
    tell(settings.say("not_another", asked=asked))
    return 0


# -- run ----------------------------------------------------------------------------------------------------------------


def unit_name(unit: str) -> str:
    return unit if "." in unit else unit + ".service"


def systemctl(settings: Settings, verb: str, unit: str, timeout: float | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        [*settings.systemctl, verb, unit_name(unit)], capture_output=True, text=True, timeout=timeout, check=False, stdin=subprocess.DEVNULL
    )


def unit_state(settings: Settings, unit: str) -> str:
    """`systemctl is-active` word; empty when systemd could not be asked (no user bus), never taken for "stopped"."""
    return systemctl(settings, "is-active", unit, timeout=30).stdout.strip()


def is_active(settings: Settings, unit: str) -> bool:
    return unit_state(settings, unit) == "active"


def _why(done: subprocess.CompletedProcess) -> str:
    lines = (done.stderr or done.stdout or "").strip().splitlines()
    return lines[-1] if lines else f"exit {done.returncode}"


def profile_users(profile: Path) -> list[int]:
    """Pids of every process that runs with --user-data-dir=<profile> (Chrome's helpers carry the flag too)."""
    wanted = f"--user-data-dir={str(profile).rstrip('/')}"
    found = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            argv = (entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if any(a.decode("utf-8", "replace").rstrip("/") == wanted for a in argv):
            found.append(int(entry.name))
    return found


def singleton_owner_alive(profile: Path) -> bool:
    """Chrome's SingletonLock is a symlink `<host>-<pid>`; a live pid on this host still owns the profile."""
    try:
        target = os.readlink(profile / "SingletonLock")
    except OSError:
        return False
    host, _, pid = target.rpartition("-")
    if host != socket.gethostname() or not pid.isdigit():
        return False
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def profile_in_use(profile: Path) -> list[int]:
    users = profile_users(profile)
    return users if users or not singleton_owner_alive(profile) else [-1]


def wait_profile_free(settings: Settings, timeout: float) -> list[int]:
    deadline = time.monotonic() + timeout
    while True:
        users = profile_in_use(settings.profile)
        if not users or time.monotonic() >= deadline:
            return users
        time.sleep(settings.poll)


@contextmanager
def profile_lock(settings: Settings):
    """One process at a time may stop the units of a profile and write into it: `relogin run` and profile-sync's `pull` share
    this flock (a file named after the profile directory; the open file holds it, the end of the process releases it)."""
    settings.lock_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(settings.lock_dir / f"{settings.profile.name}.lock", "a", encoding="utf-8") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise RunError(settings.say("profile_locked")) from None
        yield


class Guard:
    """`armed` = a signal turns into Interrupted; the cleanup path disarms it, so a second signal cannot cut it short."""

    armed = True


@contextmanager
def interrupts_as_exception():
    guard = Guard()

    def raise_interrupt(signum, _frame):
        if guard.armed:
            guard.armed = False
            raise Interrupted(signal.Signals(signum).name)

    watched = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    old = {s: signal.signal(s, raise_interrupt) for s in watched}
    try:
        yield guard
    finally:
        for s, handler in old.items():
            signal.signal(s, handler)


def stop_unit(settings: Settings, unit: str) -> str | None:
    """Stop one unit; None when it is stopped, else the printable reason. Shared with profile-sync, which tries every unit."""
    try:
        done = systemctl(settings, "stop", unit, timeout=settings.stop_timeout)
    except subprocess.TimeoutExpired:
        return settings.say("stop_failed", unit=unit, why=f"no answer in {settings.stop_timeout:.0f}s")
    if done.returncode != 0:
        try:
            state = unit_state(settings, unit)
        except subprocess.TimeoutExpired:
            state = ""  # not asked: not "stopped"
        if state not in STOPPED_STATES:
            return settings.say("stop_failed", unit=unit, why=_why(done))
    return None


def stop_units(settings: Settings) -> None:
    for unit in (settings.guardian, settings.observer, settings.browser):  # the guardian BindsTo the browser: top first
        problem = stop_unit(settings, unit)
        if problem:
            raise RunError(problem)


def launch_chrome(settings: Settings) -> subprocess.Popen:
    argv = [settings.chrome, f"--user-data-dir={settings.profile}", "--no-first-run", "--ozone-platform-hint=auto", *settings.chrome_args, settings.url]
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        raise RunError(settings.say("chrome_start_failed", why=error.strerror or str(error))) from None


def wait_window_closed(settings: Settings, chrome: subprocess.Popen) -> None:
    started = time.monotonic()
    while True:
        running = chrome.poll() is None
        if not running and not profile_in_use(settings.profile):
            if time.monotonic() - started < 3 and chrome.returncode != 0:
                raise RunError(settings.say("chrome_died", code=chrome.returncode))
            return
        time.sleep(settings.poll)


def close_chrome(settings: Settings, chrome: subprocess.Popen | None) -> None:
    """After an interruption or an error: the window must be gone before the browser unit takes the profile back."""
    if chrome is not None and chrome.poll() is None:
        chrome.terminate()
        try:
            chrome.wait(timeout=settings.stop_timeout)
        except subprocess.TimeoutExpired:
            chrome.kill()
            chrome.wait()
    wait_profile_free(settings, settings.stop_timeout)


def start_unit(settings: Settings, unit: str) -> str | None:
    """Start one unit; None when it started, else the printable reason. Shared with profile-sync, which starts the browser alone first."""
    try:
        done = systemctl(settings, "start", unit, timeout=settings.stop_timeout)
    except subprocess.TimeoutExpired:
        return settings.say("start_failed", unit=unit, why=f"no answer in {settings.stop_timeout:.0f}s")
    if done.returncode != 0:
        return settings.say("start_failed", unit=unit, why=_why(done))
    return None


def start_units(settings: Settings) -> list[str]:
    # dependency order: the browser first
    results = [start_unit(settings, unit) for unit in (settings.browser, settings.observer, settings.guardian)]
    return [line for line in results if line]


def health_seen(settings: Settings, since: str) -> bool:
    done = subprocess.run(
        [*settings.journalctl, "-u", unit_name(settings.guardian), "--since", since, "-o", "cat", "--no-pager"],
        capture_output=True,
        text=True,
        check=False,
        timeout=60,
        stdin=subprocess.DEVNULL,
    )
    return bool(HEALTH_LINE.search(done.stdout))


def wait_stack(settings: Settings, since: str, start_failures: list[str]) -> bool:
    """The three units are active and the guardian has logged a health line since `since`, within verify_timeout.
    Prints why not and returns False otherwise. Shared with profile-sync."""
    tell(settings.say("verifying", seconds=settings.verify_timeout))
    deadline = time.monotonic() + settings.verify_timeout
    while True:
        missing = []
        for unit in (settings.browser, settings.observer, settings.guardian):
            if not is_active(settings, unit):
                missing.append(settings.say("unit_down", unit=unit))
        if not missing and not health_seen(settings, since):
            missing.append(settings.say("no_health", unit=settings.guardian))
        if not missing:
            return True
        if time.monotonic() >= deadline:
            tell(settings.say("verify_failed", what="; ".join([*start_failures, *missing])), error=True)
            return False
        time.sleep(settings.poll)


def await_account(settings: Settings) -> Probe:
    """Ask the browser which account is signed in, retrying an 'unavailable' answer for account_timeout. Shared with profile-sync."""
    account_deadline = time.monotonic() + settings.account_timeout
    while True:
        # one question never outlasts what is left of the account wait (at least a second, so there is always one try)
        answer = probe(settings.port, max(1.0, min(settings.probe_timeout, account_deadline - time.monotonic())))
        if answer.kind != "unavailable" or time.monotonic() >= account_deadline:
            return answer
        time.sleep(settings.poll)


def verify(settings: Settings, since: str, start_failures: list[str]) -> int:
    if not wait_stack(settings, since, start_failures):
        return 1
    answer = await_account(settings)
    if answer.kind == "account" and answer.domain == settings.domain:
        write_marker(settings, settings.domain)
        tell(settings.say("verified_account", domain=settings.domain))
        return 0
    if answer.kind != "unavailable":
        tell(settings.say("wrong_after", what=describe_account(settings, answer)), error=True)
        return 1
    # Healthy units say nothing about WHICH account is signed in: no proof, no marker, not done.
    tell(settings.say("unreadable_after", reason=settings.say(answer.reason, port=settings.port)), error=True)
    return 1


def cmd_run(settings: Settings) -> int:
    units = [settings.guardian, settings.observer, settings.browser]
    back = [settings.browser, settings.observer, settings.guardian]
    if settings.dry_run:
        tell(settings.say("dry_run", units=", ".join(units), chrome=settings.chrome, profile=settings.profile, url=settings.url, back=", ".join(back)))
        return 0
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        tell(settings.say("no_display"), error=True)
        return 2
    if not settings.profile.is_dir():
        tell(settings.say("no_profile", path=settings.profile), error=True)
        return 2
    if not (os.access(settings.chrome, os.X_OK) and Path(settings.chrome).is_file()):
        tell(settings.say("no_chrome", path=settings.chrome), error=True)
        return 2
    try:
        with profile_lock(settings):
            return run_window(settings)
    except RunError as error:  # the lock only: run_window handles the errors of its own steps
        tell(str(error), error=True)
        return 1


def run_window(settings: Settings) -> int:
    units = [settings.guardian, settings.observer, settings.browser]
    back = [settings.browser, settings.observer, settings.guardian]
    chrome: subprocess.Popen | None = None
    failure = ""
    code = 1
    since = ""
    start_failures: list[str] = []
    with interrupts_as_exception() as guard:
        try:
            tell(settings.say("stopping", units=", ".join(units)))
            stop_units(settings)
            busy = wait_profile_free(settings, settings.stop_timeout)
            if busy:
                raise RunError(settings.say("profile_busy", seconds=settings.stop_timeout, pids=" ".join(str(p) for p in busy if p > 0) or "?"))
            tell(settings.say("opening"))
            if Path(settings.chrome).name == "chatgpt-guardian-chrome":
                tell(settings.say("no_sandbox"))
            chrome = launch_chrome(settings)
            tell(settings.say("waiting"))
            wait_window_closed(settings, chrome)
            guard.armed = False
            tell(settings.say("closed"))
        except Interrupted:
            failure, code = settings.say("interrupted"), 130
        except RunError as error:
            failure = str(error)
        finally:
            # From the first stop on, the units come back whatever happened: signals no longer interrupt, and nothing
            # before the start may fail on a terminal that has already gone away (tell swallows that).
            guard.armed = False
            if failure:
                tell(failure, error=True)
            close_chrome(settings, chrome)
            since = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(int(time.time())))
            tell(settings.say("starting", units=", ".join(back)))
            start_failures = start_units(settings)
    if failure:
        for line in start_failures:
            tell(line, error=True)
        return code
    return verify(settings, since, start_failures)


def main(argv: list[str]) -> int:
    if argv not in (["check"], ["check", "--live"], ["check", "--refuse-other"], ["run"]):
        print(TEXT["en"]["usage"], file=sys.stderr)
        return 2
    try:
        settings = load_settings(dict(os.environ))
    except ConfigError as error:
        print(f"relogin: {error}", file=sys.stderr)
        return 2
    if argv == ["run"]:
        code = cmd_run(settings)
    elif argv == ["check", "--live"]:
        code = cmd_check_live(settings)
    elif argv == ["check", "--refuse-other"]:
        code = cmd_check_refuse_other(settings)
    else:
        code = cmd_check(settings)
    for stream in (sys.stdout, sys.stderr):  # a hung-up terminal must not turn the exit code into 120 at shutdown
        try:
            stream.flush()
        except OSError:
            os.dup2(os.open(os.devnull, os.O_WRONLY), stream.fileno())
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
